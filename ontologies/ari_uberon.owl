    <!-- http://purl.obolibrary.org/obo/UBERON_0013765 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0013765">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000062"/>
        <obo:IAO_0000115>Any of the organs or elements that are part of the digestive system. Examples: tongue, esophagus, spleen, crop, lunge feeding organ, tooth elements.</obo:IAO_0000115>
        <rdfs:label>digestive system element</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0015203 -->

