        <obo:IAO_0000115>A membranous sac in animals that serves as the receptacle of a liquid or contains gas.</obo:IAO_0000115>
        <rdfs:label>bladder organ</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0034922 -->

