        <obo:IAO_0000115>An anatomical group whose component structures share a common function.</obo:IAO_0000115>
        <rdfs:label>non-connected functional system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0015204 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0015204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0015203"/>
        <obo:IAO_0000115>A non-connected functional system that is composed primarily of a gland.</obo:IAO_0000115>
        <rdfs:label>glandular system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/UBERON_0015212 -->

