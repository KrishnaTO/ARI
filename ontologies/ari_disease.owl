        <ARI_RefLink>Alliance for Cryoglobulinemia | http://allianceforcryo.org/</ARI_RefLink>
        <ARI_RefLink>Link to Cleveland Clinic | https://my.clevelandclinic.org/health/diseases/13204-cryoglobulinemia</ARI_RefLink>
        <ARI_SNOMED>239947001</ARI_SNOMED>
        <ARI_SurveyCode>EMC</ARI_SurveyCode>
        <ARI_Synonym>Autoimmune cryoglobulinemia</ARI_Synonym>
        <ARI_Synonym>Cryoglobulinemic Vasculitis</ARI_Synonym>
