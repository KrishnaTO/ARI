        <ARI_ClinicalSubtype>ALPS, Type 1A - Caused by mutations in the FAS gene.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>ALPS, Type 1B - Caused by FAS ligand mutations.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>ALPS, Type 2 - Involves CASP10 gene mutations.</ARI_ClinicalSubtype>
        <ARI_DOID>6688</ARI_DOID>
        <ARI_DXCODE>702444009</ARI_DXCODE>
