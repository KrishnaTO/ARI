    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001001_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001001_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of immunological self-tolerance in individuals with HLA-DRB1*15:03 against the NC1 domain of type VII collagen.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001001_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001001_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B cells produce pathogenic IgG autoantibodies (mostly IgG1 and IgG4) targeting type VII collagen within anchoring fibrils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001001_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001001_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Anti-type VII collagen autoantibodies bind the sub-lamina densa of the dermal-epidermal junction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001001_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001001_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Fc receptor-mediated recruitment and activation of neutrophils release elastase and matrix metalloproteinases.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001001_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001001_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Enzymatic destruction of anchoring fibrils leads to dermal-epidermal separation, skin fragility, trauma-induced tense blisters, and scarring with milia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001002_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001002_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Environmental triggers (pregnancy, malignancy, autoimmune disorders) or idiopathic loss of immune tolerance activate autoreactive CD4+ T cells against circulating Factor VIII.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001002_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001002_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of B cells produces polyclonal IgG (mostly IgG4/IgG1) autoantibodies directed against the A2, C2, or A3 domains of Factor VIII.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001002_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001002_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Anti-FVIII antibodies bind and neutralize Factor VIII procoagulant function, sterically hindering interactions with Factor IXa, phospholipids, or von Willebrand factor, or accelerating FVIII clearance.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001002_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001002_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Intrinsic tenase complex assembly is severely impaired, blocking thrombin generation and downstream fibrin formation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001002_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001002_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Ineffective hemostasis leads to spontaneous, severe mucocutaneous, intramuscular, and retroperitoneal hemorrhages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001003_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001003_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding systemic viral/bacterial infection or vaccination triggers an inflammatory state with antigen presentation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001003_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001003_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Molecular mimicry between microbial antigens and CNS myelin components (MBP, MOG) activates autoreactive CD4+ Th1 and Th17 cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001003_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001003_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primed myelin-reactive T cells cross the blood-brain barrier into the central nervous system parenchyma.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001003_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001003_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration induces recruitment of microglia and macrophages, releasing TNF-α, IFN-γ, and reactive oxygen species alongside anti-myelin autoantibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001003_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001003_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Widespread perivenular inflammation, complement activation, and demyelination across the cerebral cortex, subcortical white matter, and spinal cord result in acute multifocal neurological deficits.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001004_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001004_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inhaled or ingested pathogen/superantigen in genetically susceptible individuals triggers innate immune activation and marked endothelial activation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001004_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001004_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Robust secretion of pro-inflammatory cytokines (IL-1β, IL-6, TNF-α) by circulating monocytes and activated T cells induces systemic endothelial injury.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001004_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001004_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Anti-endothelial cell autoantibodies (AECA) and activated neutrophils infiltrate the medium-sized muscular arteries.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001004_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001004_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the coronary arterial wall causes necrotizing arteritis, internal elastic lamina breakdown, and destruction of the vascular media.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001004_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001004_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of structural integrity results in coronary artery ectasia, aneurysm formation, thrombotic occlusion, or myocardial ischemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001005_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001005_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Viral infection, medication exposure, or immune trigger induces an aberrant clonal CD8+ T-cell cutaneous response.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001005_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001005_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Antigen-driven recruitment of cytotoxic T lymphocytes occurs at the superficial vascular plexus and dermal-epidermal junction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001005_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001005_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltrating CD8+ T cells and granzyme/perforin release induce widespread hydropic degeneration and apoptosis of basal epidermal keratinocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001005_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001005_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Perivascular lymphocytic cuffing and microvascular endothelial damage trigger erythrocyte extravasation and focal necrosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001005_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001005_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Widespread epidermal necrosis, crusting, and intraepidermal vesiculation manifest clinically as recurring inflammatory crusted papules.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001006_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001006_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of central or peripheral immune tolerance in individuals with high-risk HLA-DR3-DQ2/DR4 haplotypes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001006_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001006_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Antigen-presenting cells present the microsomal enzyme steroid 21-hydroxylase (CYP21A2) to naive T helper cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001006_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001006_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Generation of autoreactive CD4+ Th1 cells and 21-hydroxylase-specific autoantibodies (ACA) accompanied by CD8+ cytotoxic T cell expansion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001006_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001006_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Lymphocytic infiltration of the adrenal cortex with perforin-, granzyme-, and IFN-γ-mediated apoptosis of steroidogenic cells in the zona fasciculata, glomerulosa, and reticularis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001006_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001006_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive cortical atrophy (&gt;90% destruction) depletes cortisol, aldosterone, and adrenal androgens, leading to life-threatening adrenal crisis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001007_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001007_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (predominantly HLA-DRB1*15:02 and HLA-DRB1*16:02) combined with unknown environmental exposures triggers immune dysregulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001007_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001007_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B-cell expansion and plasma cell differentiation produce high-titer neutralizing IgG autoantibodies targeting interferon-gamma (IFN-γ).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001007_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001007_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating autoantibodies bind endogenous IFN-γ, blocking its interaction with cell-surface IFN-γ receptors (IFNGR1/IFNGR2).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001007_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001007_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inhibition of IFN-γ signaling abolishes STAT1 phosphorylation, impairing macrophage activation, nitric oxide production, and phagolysosomal maturation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001007_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001007_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Collapse of cell-mediated immunity leaves tissues unable to control intracellular pathogens, resulting in disseminated non-tuberculous mycobacterial (NTM) infections and opportunistic fungal disease.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001008_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001008_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Environmental pathogen exposure or danger-associated molecular patterns (DAMPs) activate the NLRP3 inflammasome in genetically predisposed hosts.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001008_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001008_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive overproduction and systemic release of pro-inflammatory cytokines, specifically IL-1β, IL-6, and IL-18.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001008_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001008_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Profound neutrophil and monocyte/macrophage hyperactivation, causing massive release of ferritin and acute-phase reactants.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001008_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001008_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Systemic cytokine storm induces capillary endothelial leakage, microvascular inflammation, and synovial hypervascularity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001008_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001008_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Persistent hyperinflammatory cascade leads to quotidian spiking fevers, evanescent macular rash, serositis, proliferative synovitis, and potential macrophage activation syndrome (MAS).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001009_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001009_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Aging, oxidative stress, cigarette smoke, and genetic variants in complement genes (CFH, CFI, C3) impair retinal pigment epithelium (RPE) proteostasis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001009_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001009_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Accumulation of intracellular lipofuscin and extracellular lipid-protein deposits (drusen) in Bruch&apos;s membrane.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001009_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001009_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Uncontrolled alternative complement pathway activation and local macrophage infiltration initiate chronic parainflammation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001009_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001009_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Sustained oxidative and inflammatory injury drives progressive apoptosis of RPE cells and adjacent overlying photoreceptor rods and cones (geographic atrophy).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001009_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001009_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>In wet AMD, elevated vascular endothelial growth factor (VEGF) induces aberrant choroidal neovascularization with subretinal leakage and scarring.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001010_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001010_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Environmental stressors and genetic risk variants collapse the physiological immune privilege of anagen hair follicles.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001010_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001010_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Upregulation of MHC Class I (HLA-A/B/C) and MICA/ULBP3 molecules on the follicular epithelium.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001010_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001010_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD8+ NKG2D+ cytotoxic T cells and CD4+ Th1 cells recognize hair follicle melanocyte/keratinocyte autoantigens (trichohyalin).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001010_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001010_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dense peribulbar lymphocytic infiltration (&quot;swarm of bees&quot;) and massive production of IFN-γ and IL-15 induce premature transition from anagen into catagen/telogen phase.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001010_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001010_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Follicular dystrophy, structural shaft weakening, and hair detachment cause patchy to universal non-scarring alopecia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001011_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001011_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Idiopathic triggers, somatic mutations, or HHV-8 viral infection stimulate lymph node stromal cells and follicular dendritic cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001011_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001011_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive, dysregulated secretion of interleukin-6 (IL-6) into the local microenvironment and systemic circulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001011_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001011_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>IL-6 promotes hyperplastic germinal center proliferation, follicular dendritic cell hyperplasia, and robust endothelial vascular proliferation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001011_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001011_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Downstream induction of hepatic acute-phase reactants (CRP, fibrinogen) and polyclonal hypergammaglobulinemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001011_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001011_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Systemic inflammatory cascade drives constitutional symptoms, marked lymphadenopathy, hepatosplenomegaly, anasarca, and cytopenias.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001012_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001012_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic predisposition via HLA-B*27 misfolding, endoplasmic reticulum stress, or microbial gut dysbiosis triggers IL-23 release by myeloid cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001012_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001012_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activation and expansion of IL-23R-bearing cells (Th17, γδ T cells, ILC3s) in the circulation and bone-tendon interfaces.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001012_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001012_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of entheses and sacroiliac joints, followed by massive secretion of IL-17A, IL-22, and TNF-α.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001012_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001012_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Local inflammation drives osteoclast-mediated subchondral bone erosion and enthesitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001012_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001012_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>IL-22 and Wnt pathway signaling subsequently drive aberrant osteoblast activation, chondrogenesis, syndesmophyte growth, and progressive spinal fusion (ankylosis).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001013_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001013_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primary autoimmune trigger or occult thymoma induces loss of tolerance to contactin-associated protein-like 2 (CASPR2).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001013_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001013_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of pathogenic IgG4 (and IgG1) autoantibodies directed against CASPR2.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001013_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001013_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>CASPR2 autoantibodies bind the juxtaparanodal regions of myelinated peripheral axons and synaptic terminals of central limbic circuits.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001013_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001013_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Disruption of the CASPR2-contactin-1 macromolecular complex displaces voltage-gated potassium channels (Kv1.1/Kv1.2).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001013_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001013_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Impaired potassium conductance results in axonal hyperexcitability, causing peripheral nerve hyperexcitability (neuromyotonia, fasciculations) and central limbic encephalopathy (amnesia, insomnia, Morvan syndrome).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001014_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001014_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Environmental triggers (hydrocarbon exposure, smoking, viral infection) expose cryptic epitopes within the α3 chain non-collagenous 1 domain of type IV collagen [α3(IV)NC1].</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001014_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001014_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of tolerance in HLA-DRB1*15:01 individuals leads to high-affinity autoantibody synthesis (predominantly IgG1 and IgG3).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001014_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001014_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating anti-GBM antibodies bind linearly to the α3(IV)NC1 hexamer in the glomerular and alveolar basement membranes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001014_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001014_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Classical complement pathway activation and recruitment of neutrophils and monocytes via Fcγ receptors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001014_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001014_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Lytic enzyme release and reactive oxygen species destroy capillary walls, causing crescentic necrotizing glomerulonephritis, rapidly progressive renal failure, and diffuse pulmonary alveolar hemorrhage.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001015_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001015_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal proliferation of low-grade B cells/plasmacytoid lymphocytes (often IgM MGUS or Waldenström macroglobulinemia).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001015_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001015_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of monoclonal IgM autoantibodies directed against the HNK-1 carbohydrate epitope on myelin-associated glycoprotein (MAG).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001015_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001015_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Monoclonal IgM penetrates the blood-nerve barrier and binds MAG at the periaxonal space and paranodal loops of Schwann cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001015_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001015_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>IgM binding triggers classical complement pathway activation and terminal membrane attack complex (C5b-9) deposition.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001015_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001015_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Widening of outer myelin lamellae, progressive demyelination, and secondary axonal degeneration cause a symmetric, distal, sensory-predominant polyneuropathy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001016_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001016_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Viral trigger or mucosal injury in genetically susceptible hosts upregulates melanoma differentiation-associated protein 5 (MDA5).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001016_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001016_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activation of autoreactive B and T cells produces anti-MDA5 autoantibodies alongside massive type I interferon pathway induction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001016_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001016_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of CXCR3+ T cells and macrophages into cutaneous and pulmonary capillary microvasculature.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001016_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001016_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Endothelial injury, intense chemokine release (CXCL9/CXCL10), and macrophage activation in alveolar walls.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001016_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001016_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extensive alveolar epithelial necrosis, rapid fibroblastic proliferation, and ulcerating vasculopathy produce rapidly progressive interstitial lung disease (RPILD) and mucocutaneous ulcerations.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001017_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001017_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-DP/DQ, PTPN22) and environmental priming (silica, infections) upregulate inflammatory cytokines (TNF-α, IL-1β).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001017_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001017_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primed neutrophils translocate intracellular myeloperoxidase (MPO) or proteinase 3 (PR3) to the external plasma membrane.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001017_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001017_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pathogenic ANCA autoantibodies bind cell-surface PR3 or MPO, cross-linking Fcγ receptors and triggering intense neutrophil activation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001017_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001017_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activated neutrophils release reactive oxygen species, lytic enzymes, and neutrophil extracellular traps (NETs), damaging vascular endothelial cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001017_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001017_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Alternate complement pathway amplification (C5a) recruits further inflammatory cells, causing fibrinoid necrosis of small vessels, glomerulonephritis, and organ ischemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001018_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001018_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>&quot;Two-hit&quot; mechanism: Genetic predisposition and infection/endothelial trauma expose domain I of beta-2-glycoprotein I (β2-GPI).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001018_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001018_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of pathogenic antiphospholipid antibodies (aPL: anti-β2-GPI, lupus anticoagulant, anticardiolipin).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001018_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001018_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind oxidized β2-GPI on endothelial cells, platelets, monocytes, and trophoblast membranes, cross-linking receptors (TLR4, ApoER2&apos;).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001018_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001018_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Intracellular signaling upregulates tissue factor, downregulates endothelial nitric oxide synthase, inhibits protein C activation, and activates complement (C5a).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001018_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001018_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Persistent procoagulant phenotype drives recurrent arterial/venous thromboses and placental microvascular thrombosis leading to pregnancy complications.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001019_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001019_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Environmental exposures (inhalants, viral infections) cause lung epithelial stress, releasing aminoacyl-tRNA synthetases (predominantly Jo-1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001019_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001019_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cleaved synthetases act as chemoattractants and autoantigens, stimulating toll-like receptors and dendritic cell maturation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001019_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001019_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of anti-aminoacyl-tRNA synthetase antibodies and activation of CD4+ Th1/Th17 and CD8+ cytotoxic T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001019_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001019_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>T-cell infiltration and cytokine release in skeletal muscle endomysium and alveolar parenchymal interstitium.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001019_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001019_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Muscle fiber necrosis, perivascular lung inflammation, and progressive interstitial pulmonary fibrosis cause inflammatory myositis and interstitial lung disease (ILD).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001020_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001020_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Mechanical hemodynamic stress, oxidized lipids, or genetic variants trigger innate immune activation in valvular interstitial cells (VICs).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001020_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001020_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Recruitment of macrophages and T lymphocytes with persistent secretion of IL-1β, TNF-α, and IL-6.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001020_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001020_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Sustained inflammation stimulates VIC transdifferentiation into osteoblast-like cells via RUNX2 and BMP-2 signaling.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001020_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001020_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Active mineralization and dystrophic calcification of aortic valve leaflets with extracellular matrix degradation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001020_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001020_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Leaflet stiffening, immobility, and progressive narrowing of the aortic orifice cause severe aortic stenosis and left ventricular overload.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001021_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001021_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Environmental insult (viral infection, drug, toxin) or genetic variant triggers aberrant antigen presentation on hematopoietic stem and progenitor cells (HSPCs).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001021_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001021_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of autoreactive CD8+ cytotoxic T cells and oligoclonal CD4+ Th1 cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001021_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001021_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Effector T cells home to the bone marrow microenvironment, releasing excessive interferon-gamma (IFN-γ) and TNF-α.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001021_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001021_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>IFN-γ upregulates Fas receptors and activates the nitric oxide synthase pathway within CD34+ stem cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001021_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001021_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Fas/FasL-mediated apoptosis of hematopoietic stem cells depletes pluripotential progenitors, leading to marrow hypocellularity and pancytopenia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001022_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001022_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic deletion of CFHR1/CFHR3 primes the immune system to produce autoantibodies against complement factor H (CFH).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001022_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001022_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Development of high-affinity IgG autoantibodies directed against the C-terminal recognition domains (SCR 19-20) of Factor H.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001022_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001022_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies block Factor H binding to cell-surface polyanions (heparan sulfate/sialic acid) on glomerular microvascular endothelial cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001022_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001022_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of local complement regulatory activity triggers uncontrolled activation of the alternative complement pathway on endothelial surfaces.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001022_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001022_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>C3b amplification and C5b-9 deposition cause endothelial swelling, microvascular thrombosis, erythrocyte mechanical fragmentation, and acute renal failure.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001023_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001023_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B-cell proliferation or immune dysregulation generates neutralizing autoantibodies against C1 esterase inhibitor (C1-INH).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001023_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001023_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind and accelerate the functional inactivation and clearance of circulating C1-INH.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001023_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001023_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Depletion of C1-INH eliminates its baseline inhibitory control over the contact activation (kallikrein-kinin) and classical complement pathways.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001023_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001023_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unchecked plasma kallikrein cleaves high-molecular-weight kininogen (HMWK), generating excessive quantities of bradykinin.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001023_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001023_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Excessive bradykinin binds vascular endothelial B2 receptors, inducing rapid postcapillary venular hyperpermeability, vasodilation, and non-pruritic subcutaneous and submucosal edema.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001024_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001024_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primary loss of self-tolerance against intracellular or surface cerebellar Purkinje cell antigens (e.g., GAD65, TG6).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001024_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001024_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ and cytotoxic CD8+ T lymphocytes cross the blood-brain barrier alongside antigen-specific autoantibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001024_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001024_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Local immune responses cause neuroinflammation in the cerebellar cortex and deep cerebellar nuclei.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001024_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001024_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Effector T-cell cytotoxicity, neurotoxic cytokine release, and autoantibody-mediated disruption of GABAergic synthesis occur.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001024_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001024_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive degeneration and apoptosis of cerebellar Purkinje neurons lead to irreversible cerebellar atrophy, dysmetria, and ataxia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001025_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001025_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Central autoimmune dysregulation leads to targeting of magnocellular vasopressinergic neurons in the hypothalamic supraoptic and paraventricular nuclei.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001025_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001025_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies against vasopressin-secreting cells (AVPc-Ab) and autoreactive cytotoxic CD8+ T cells target the hypothalamic-neurohypophyseal tract.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001025_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001025_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Lymphocytic infundibuloneurohypophysitis induces swelling and lymphocytic infiltration of the pituitary stalk and posterior pituitary.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001025_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001025_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive destruction of arginine vasopressin (AVP)-producing neurosecretory cell bodies and neurohypophyseal terminals.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001025_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001025_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Total deficiency of circulating vasopressin abolishes renal aquaporin-2 translocation in the collecting duct, causing severe polyuria and polydipsia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001027_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001027_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Systemic autoimmune disorder or local trauma triggers an immune response against inner ear antigens (cochlin, type II collagen, Hsp70).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001027_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001027_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ Th1 cells and circulating antibodies enter the cochlea via the spiral modiolar vein.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001027_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001027_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deposition of immune complexes and localized release of pro-inflammatory cytokines (IL-1β, TNF-α, IFN-γ) within the stria vascularis and spiral ligament.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001027_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001027_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Destruction of marginal and intermediate cells compromises endolymph production, cochlear blood flow, and potassium homeostasis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001027_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001027_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Degeneration of cochlear sensory hair cells and spiral ganglion neurons causes rapidly progressive, fluctuating bilateral sensorineural hearing loss.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001028_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001028_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Tumor expression of neural antigens, viral neuroinvasive infection (e.g., HSV-1), or systemic autoimmunity breaks self-tolerance to neuronal antigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001028_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001028_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primed autoreactive B cells and T cells cross the blood-brain barrier and establish intrathecal residence.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001028_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001028_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of pathogenic autoantibodies against neuronal surface proteins, ion channels, or receptors, alongside cytotoxic T-cell infiltrates.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001028_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001028_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies mediate receptor internalization, synaptic disruption, or complement activation, while T cells mediate neuronal lysis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001028_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001028_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive cortical and subcortical neuronal dysfunction leads to acute encephalopathy, seizures, psychosis, memory loss, and coma.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001029_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001029_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Ectopic expression of NR1/NR2 subunits in an ovarian teratoma (or post-herpetic viral trigger) primes naive B and T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001029_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001029_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Differentiation into plasmablasts producing IgG (predominantly IgG1) against the GluN1 (NR1) subunit of the NMDA receptor.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001029_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001029_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pathogenic anti-GluN1 antibodies cross the blood-brain barrier and bind extracellular NMDA receptors on forebrain and hippocampal neurons.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001029_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001029_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies cross-link GluN1 receptors, displacing them from synaptic scaffolding and triggering selective internalization and degradation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001029_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001029_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive reduction of synaptic NMDA receptor density abolishes frontostriatal GABAergic inhibition, triggering psychosis, catatonia, autonomic instability, and seizures.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001030_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001030_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding viral illness or immune trigger provokes loss of tolerance to the ganglionic nicotinic acetylcholine receptor (gAChR).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001030_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001030_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B cells synthesize pathogenic autoantibodies directed against the α3 subunit of the gAChR.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001030_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001030_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating autoantibodies bind ganglionic nicotinic receptors in sympathetic and parasympathetic autonomic ganglia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001030_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001030_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Receptor binding causes antibody-mediated receptor internalization, functional blockade, and accelerated lysosomal degradation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001030_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001030_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of functional ganglionic acetylcholine receptors halts fast synaptic transmission across autonomic ganglia, leading to severe orthostatic hypotension, anhidrosis, gastroparesis, and tonic pupils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001031_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001031_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (HLA-DRB1*03/04) drives immune loss of tolerance against gastric parietal cell H+/K+-ATPase and intrinsic factor.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001031_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001031_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ Th1 cells infiltrate the gastric oxyntic mucosa, releasing IFN-γ and recruiting cytotoxic CD8+ T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001031_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001031_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies against H+/K+-ATPase and intrinsic factor develop, accompanied by progressive cell-mediated apoptosis of parietal cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001031_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001031_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Destruction of oxyntic glands causes achlorhydria (impaired iron absorption) and loss of intrinsic factor secretion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001031_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001031_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Failure of ileal vitamin B12 absorption leads to megaloblastic anemia, subacute combined degeneration of the spinal cord, and neuroendocrine G-cell hyperplasia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001032_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001032_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of peripheral tolerance prompts clonal expansion of autoreactive B cells targeting erythrocyte surface antigens (Rh proteins, I/i carbohydrates).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001032_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001032_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of pathogenic anti-erythrocyte autoantibodies (warm IgG or cold IgM agglutinins).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001032_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001032_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies opsonize circulating red blood cells, which may fix complement component C3b.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001032_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001032_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>In warm AIHA, Fc and C3b receptors on splenic and hepatic macrophages induce partial or complete phagocytosis, forming spherocytes and extravascular hemolysis; in cold AIHA, intravascular complement lysis occurs.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001032_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001032_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Accelerated red blood cell destruction overwhelms bone marrow compensatory erythropoiesis, resulting in severe anemia, jaundice, and hemoglobinuria.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001033_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001033_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Environmental triggers (drugs, viruses) in genetically predisposed individuals (HLA-DR3/DR4) expose hepatocyte-specific antigens (CYP2D6, FTCD, SLA).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001033_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001033_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Liver-derived autoantigens presented by dendritic cells activate autoreactive naive T cells, differentiating into Th1 and Th17 effectors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001033_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001033_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of characteristic autoantibodies (ANA, ASMA, anti-LKM1) and robust recruitment of CD8+ cytotoxic T cells and monocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001033_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001033_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltrating CD8+ T cells, granzyme B, and IFN-γ trigger interface hepatitis with piecemeal necrosis of periportal hepatocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001033_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001033_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Sustained lobular inflammation drives hepatic stellate cell activation, extensive collagen deposition, bridging fibrosis, and eventual cirrhosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001034_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001034_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoimmune polyglandular syndrome type 1 (APS-1/AIRE mutation) or isolated autoimmunity breaks tolerance to parathyroid antigens (CaSR, NALP5).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001034_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001034_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activation of autoreactive CD4+ and CD8+ T lymphocytes alongside anti-CaSR/anti-NALP5 autoantibody production.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001034_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001034_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the parathyroid glands by mononuclear lymphocytes and cytotoxic effectors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001034_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001034_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Destruction of parathyroid chief cells and blocking autoantibodies against the calcium-sensing receptor impair parathyroid hormone (PTH) secretion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001034_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001034_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Marked deficiency of PTH halts bone calcium resorption and renal calcium reabsorption, causing hypocalcemia, hyperphosphatemia, and neuromuscular tetany.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001035_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001035_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pregnancy, immune checkpoint inhibitor therapy (anti-CTLA-4), or genetic factors induce autoimmunity against adenohypophyseal antigens (Pit-1, POMC).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001035_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001035_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ T cells infiltrate the anterior pituitary gland, releasing pro-inflammatory cytokines and recruiting cytotoxic lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001035_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001035_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of anti-pituitary antibodies (APA) and massive lymphoplasmacytic infiltration of the adenohypophysis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001035_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001035_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Interstitial edema and progressive apoptosis of hormone-producing corticotrophs, thyrotrophs, and gonadotrophs cause pituitary gland enlargement.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001035_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001035_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Subsequent tissue fibrosis and parenchymal destruction produce mass effect (headaches, chiasmatic visual loss) and panhypopituitarism.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001036_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001036_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic exposure to foreign adjuvant substances (silicone implants, aluminum adjuvants, infectious components) in genetically susceptible hosts (HLA-DRB1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001036_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001036_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Adjuvant binds innate pattern recognition receptors (TLRs, NOD-like receptors), driving persistent inflammasome activation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001036_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001036_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Continuous release of pro-inflammatory cytokines (IL-1β, IL-6, TNF-α) and adjuvant translocation to regional lymph nodes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001036_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001036_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic hyperstimulation breaks self-tolerance, promoting polyclonal B-cell activation and autoantibody formation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001036_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001036_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Systemic chronic inflammation causes generalized fatigue, arthralgias, myalgias, and potential transition into defined systemic autoimmune diseases.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001037_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001037_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Covert onconeural antigen expression or viral CNS trigger primes cell-mediated immunity against uncharacterized intracellular neuronal antigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001037_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001037_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activated cytotoxic CD8+ T cells cross the blood-brain barrier and infiltrate the limbic system (hippocampus, amygdala, insular cortex).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001037_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001037_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Effector CD8+ T cells engage neuronal targets, releasing perforin and granzyme granules directly onto neuronal somas.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001037_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001037_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Mononuclear inflammation and microglial nodule formation drive extensive neurotoxicity and apoptotic cell death in hippocampal pyramidal neurons.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001037_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001037_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of limbic neuronal networks causes acute/subacute short-term memory deficits, psychiatric symptoms, and temporal lobe epilepsy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001038_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001038_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Germline or somatic mutations in apoptosis-regulating genes of the extrinsic pathway (FAS, FASLG, CASP10).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001038_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001038_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Failure of activation-induced cell death (AICD) in lymphocytes following antigen encounter and clearance.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001038_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001038_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Uncontrolled accumulation and survival of chronically stimulated TCRαβ+ CD4- CD8- &quot;double-negative&quot; T (DNT) cells and autoreactive B cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001038_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001038_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>DNT cells produce excessive IL-10 and Fas-resistant B-cell clones produce pathogenic autoantibodies (anti-RBC, anti-platelet, anti-neutrophil).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001038_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001038_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive lymphoid tissue hyperplasia (splenomegaly, lymphadenopathy, hepatomegaly) and recurrent autoimmune cytopenias.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001039_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001039_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Exposure to statins, malignancy, or viral triggers in genetically predisposed individuals (HLA-DRB1*11:01).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001039_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001039_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Generation of high-titer pathogenic autoantibodies directed against 3-hydroxy-3-methylglutaryl-coenzyme A reductase (HMGCR) or signal recognition particle (SRP).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001039_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001039_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind targets on skeletal muscle myofibers, fixing complement and depositing terminal C5b-9 complexes on the sarcolemma.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001039_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001039_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complement-mediated myofiber membrane damage triggers massive myofiber necrosis without significant lymphocytic inflammatory infiltrates.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001039_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001039_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe, rapidly progressive symmetric proximal muscle weakness, profound creatine kinase elevations, and extensive myofiber degeneration and myophagocytosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001040_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001040_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Idiopathic breakdown of B-cell tolerance or post-viral stimulation in young children or adults leads to production of antineutrophil antibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001040_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001040_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of IgG autoantibodies specifically targeting human neutrophil antigens (HNA-1a, HNA-1b, HNA-1c, HNA-2).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001040_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001040_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind surface glycoproteins on circulating mature polymorphonuclear neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001040_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001040_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Opsonized neutrophils undergo accelerated Fc receptor-mediated phagocytosis and clearance by the reticuloendothelial system in the spleen and liver.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001040_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001040_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Profound absolute neutropenia leads to recurrent bacterial infections, skin abscesses, and mucosal ulcerations.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001041_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001041_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (often part of polyglandular autoimmune syndromes) leads to loss of tolerance against ovarian steroid-producing cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001041_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001041_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Development of anti-steroid-producing cell antibodies (anti-StCA) targeting CYP17A1 and CYP11A1 enzymes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001041_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001041_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ and CD8+ cytotoxic T cells infiltrate the ovaries, selectively surrounding developing follicles.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001041_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001041_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Mononuclear inflammatory destruction of the theca interna and granulosa cells, sparing primordial follicles initially.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001041_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001041_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive follicular destruction and luteal atrophy lead to premature ovarian insufficiency, amenorrhea, and hypergonadotropic hypogonadism.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001042_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001042_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Isolated immune dysregulation or molecular mimicry primes autoreactive T cells against optic nerve glial or axonal autoantigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001042_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001042_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive lymphocytes and macrophages breach the blood-optic nerve barrier, infiltrating optic nerve parenchyma and meningeal sheaths.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001042_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001042_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Local secretion of pro-inflammatory cytokines, reactive nitrogen species, and matrix metalloproteinases triggers inflammation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001042_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001042_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inflammatory edema within the non-distensible bony optic canal leads to compressive axonal ischemia and focal demyelination.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001042_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001042_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Conduction block and retrograde degeneration of retinal ganglion cells cause painful acute loss of visual acuity and central visual field defects.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001043_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001043_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>In Type 1, IgG4-related systemic disease driven by CD4+ cytotoxic T cells and IgG4+ plasmablasts; in Type 2, granulocytic duct epithelial lesions driven by neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001043_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001043_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the pancreatic parenchyma and periductal stroma by dense lymphoplasmacytic infiltrates or granulocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001043_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001043_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Local cytokine release (IL-10, TGF-β) in Type 1 induces abundant &quot;storiform&quot; interstitial fibrosis and obliterative phlebitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001043_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001043_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Compressive narrowing of the main pancreatic duct and distal common bile duct.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001043_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001043_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Diffuse sausage-like pancreatic swelling, exocrine/endocrine dysfunction, and painless obstructive jaundice.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001044_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001044_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Prior exposure to exogenous progestins or pregnancy sensibilizes the adaptive immune system to endogenous luteal progesterone.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001044_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001044_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Development of progesterone-specific IgE/IgG antibodies and CD4+ Th2 lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001044_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001044_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>During the luteal phase of the menstrual cycle, surging serum progesterone levels bind specific immune receptors in cutaneous tissues.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001044_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001044_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Mast cell degranulation and CD4+ T-cell activation release histamine, leukotrienes, and pro-inflammatory cytokines into the dermis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001044_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001044_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Recurrent cyclic cutaneous eruptions (urticaria, erythema multiforme-like lesions, eczema, angioedema) synchronize precisely with the luteal phase.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001045_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001045_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of immune tolerance prompts clonal B cells to produce high-titer neutralizing IgG autoantibodies against granulocyte-macrophage colony-stimulating factor (GM-CSF).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001045_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001045_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating and alveolar anti-GM-CSF autoantibodies bind and neutralize GM-CSF, blocking its interaction with the GM-CSF receptor on alveolar macrophages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001045_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001045_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inhibition of GM-CSF signaling halts PU.1 transcription factor expression, severely arresting alveolar macrophage terminal differentiation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001045_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001045_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immature alveolar macrophages lose the capacity to catabolize and clear pulmonary surfactant lipids and proteins.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001045_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001045_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive, progressive intra-alveolar accumulation of periodic acid-Schiff (PAS)-positive lipoproteinaceous surfactant causes impaired gas exchange and dyspnea.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001046_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001046_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of ocular immune privilege exposes inner blood-retina barrier antigens to primed autoreactive T lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001046_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001046_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ Th1/Th17 cells and B cells infiltrate retinal perivascular sheaths and vascular adventitia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001046_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001046_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inflammatory cytokine secretion (IFN-γ, TNF-α) and immune complex deposition cause endothelial activation and disruption of tight junctions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001046_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001046_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of neutrophils and macrophages induces microvascular thrombosis, perivascular cuffing, and focal retinal ischemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001046_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001046_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Retinal capillary non-perfusion, macular edema, and neovascularization lead to vitreous hemorrhage and progressive visual loss.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001047_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001047_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Paraneoplastic (cancer-associated retinopathy) or non-paraneoplastic immune response generates autoantibodies against retinal antigens (recoverin, α-enolase).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001047_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001047_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating antiretinal autoantibodies breach a compromised blood-retina barrier and enter the neurosensory retina.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001047_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001047_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies penetrate photoreceptor cells and bind intracellular antigens like recoverin, uncoupling phototransduction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001047_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001047_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Intracellular calcium overload triggers caspase-dependent apoptotic pathways in rod and cone photoreceptors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001047_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001047_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive degeneration and loss of photoreceptors and retinal ganglion cells cause photoaversion, night blindness, scotomas, and central visual loss.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001048_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001048_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-DR3/DR5, CTLA4, PTPN22) and environmental factors trigger thyroid follicular cell stress.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001048_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001048_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Presentation of thyroid peroxidase (TPO) and thyroglobulin (Tg) by dendritic cells to autoreactive CD4+ T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001048_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001048_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of CD4+ Th1/Th17 cells, B cells producing anti-TPO/anti-Tg antibodies, and CD8+ cytotoxic T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001048_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001048_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dense lymphocytic infiltration of the thyroid parenchyma with germinal center formation and Hürthle cell metaplasia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001048_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001048_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Perforin/granzyme- and Fas/FasL-mediated apoptosis of thyrocytes leads to follicular destruction, interstitial fibrosis, and primary hypothyroidism.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001049_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001049_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Idiopathic autoimmune breakdown promotes B-cell production of functional IgG autoantibodies against the FcεRIα subunit or IgE.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001049_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001049_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating IgG autoantibodies bind the high-affinity IgE receptor (FcεRIα) or receptor-bound IgE on cutaneous mast cells and basophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001049_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001049_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cross-linking of adjacent FcεRI receptors triggers classical complement activation (generating anaphylatoxin C5a) and mast cell degranulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001049_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001049_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Rapid exocytosis of histamine, leukotrienes, prostaglandins, and platelet-activating factor into the upper dermis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001049_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001049_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Local pre-capillary vasodilation, enhanced postcapillary venular permeability, and sensory nerve ending excitation produce transient wheals and pruritus.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001050_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001050_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B cells synthesize IgG autoantibodies directed against FcεRIα, IgE, or C1-esterase inhibitor.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001050_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001050_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibody binding cross-links FcεRI receptors on mast cells and basophils, triggering immediate degranulation and complement amplification.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001050_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001050_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Release of vasoactive mediators (histamine, bradykinin, leukotrienes C4/D4) spreads from the superficial dermis to deep dermis and submucosa.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001050_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001050_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Profound microvascular hyperpermeability and marked vasodilatation allow massive plasma extravasation into interstitial spaces.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001050_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001050_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extensive tissue swelling results in coexisting erythematous urticarial wheals and painful, non-pitting deeper subcutaneous/submucosal angioedema.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001051_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001051_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of immune tolerance and infectious or environmental priming upregulate endothelial adhesion molecules and activate neutrophils/monocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001051_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001051_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Generation of pathogenic autoantibodies (such as ANCA or anti-endothelial cell antibodies) or immune complexes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001051_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001051_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of vessel walls by autoreactive T cells, macrophages, or antibody-activated neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001051_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001051_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Release of reactive oxygen species, lytic proteases, and pro-inflammatory cytokines induces transmural vascular necrosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001051_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001051_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Luminal thrombosis, vascular occlusion, or aneurysmal rupture leads to tissue ischemia, purpura, and multi-organ dysfunction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001052_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001052_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unknown environmental or viral trigger induces aggressive central nervous system autoreactivity against myelin basic protein.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001052_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001052_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive influx of autoreactive CD4+/CD8+ T cells, activated microglia, and macrophages across the blood-brain barrier.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001052_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001052_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Local secretion of neurotoxic cytokines, nitric oxide, and reactive oxygen species at the expanding edge of the demyelinating lesion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001052_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001052_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Hypoxia-inducible factor 1α (HIF-1α) and heat shock proteins (Hsp70) transiently upregulate in adjacent tissue, creating a temporary rim of neuroprotection.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001052_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001052_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cyclic waves of demyelinating injury and sublethal preservation produce alternating concentric rings of demyelinated and preserved white matter.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001053_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001053_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic association with HLA-B*51 and microbial/environmental triggers activate neutrophil hyperfunction and innate pathways.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001053_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001053_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Hyperactive neutrophils and CD4+ Th1/Th17 lymphocytes infiltrate venules and arteries across multiple organ systems.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001053_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001053_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Abundant secretion of IL-1β, IL-6, IL-17, and TNF-α promotes endothelial cell activation and prothrombotic state.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001053_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001053_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transmural perivascular neutrophilic infiltration and leukocytoclasis cause panvascular endothelial damage without necrotizing granulomas.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001053_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001053_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Recurrent aphthous oral/genital ulcers, hypopyon uveitis, pathergy, and venous/arterial thromboses develop.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001054_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001054_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of tolerance against basement membrane hemidesmosomal proteins (BP180, laminin-332, integrin α6β4).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001054_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001054_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B cells produce pathogenic IgG (IgG4/IgG1) and IgA autoantibodies targeting the mucosal basement membrane zone.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001054_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001054_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind extracellular epitopes, activating complement and recruiting neutrophils, eosinophils, and mast cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001054_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001054_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Proteolytic enzymes cleave the dermal-epidermal junction, producing subepithelial blister formation on mucous membranes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001054_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001054_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic mucosal ulceration, TGF-β release, and exuberant fibroblast activation cause progressive cicatrization, conjunctival symblepharon, and airway strictures.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001055_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001055_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding Campylobacter jejuni or viral infection displays lipooligosaccharides structurally mimicking GQ1b gangliosides.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001055_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001055_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Molecular mimicry drives production of high-titer IgG autoantibodies directed against GQ1b/GT1a gangliosides.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001055_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001055_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Anti-GQ1b antibodies cross the blood-brain barrier and bind densely expressed GQ1b antigens on the brainstem reticular formation and oculomotor nerves.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001055_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001055_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Classical complement pathway activation and deposition of membrane attack complexes (C5b-9) at presynaptic motor nerve terminals.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001055_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001055_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Blockade of acetylcholine release and neuronal conduction failure produce acute ophthalmoplegia, severe ataxia, and central disturbance of consciousness.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001056_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001056_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extremely strong genetic association with HLA-A*29:02 (&gt;95%) primes an aberrant CD8+ and CD4+ T-cell response.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001056_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001056_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of retinal-choroidal immune tolerance exposes retinal S-antigen and interphotoreceptor retinoid-binding protein (IRBP).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001056_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001056_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the choroid and outer retina by HLA-A29-restricted cytotoxic CD8+ T cells and Th17/Th1 lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001056_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001056_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of IL-17, IFN-γ, and TNF-α leads to multifocal stromal choroiditis and retinal periphlebitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001056_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001056_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive chorioretinal atrophy, depigmented &quot;birdshot&quot; fundus lesions, cystoid macular edema, and irreversible visual field constriction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001057_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001057_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of self-tolerance in elderly individuals (associated with HLA-DQB1*03:01 or dipeptidyl peptidase-4 inhibitors) against hemidesmosomal BP180 and BP230.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001057_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001057_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ Th2/Th1 cells stimulate B cells to synthesize IgG (mostly IgG4/IgG1) and IgE autoantibodies against the NC16A domain of BP180.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001057_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001057_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind BP180 at the dermal-epidermal junction, activating complement and recruiting eosinophils and neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001057_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001057_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Eosinophil-derived major basic protein and neutrophil elastase degrade extracellular collagen XVII anchoring filaments.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001057_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001057_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dermal-epidermal separation forms tense subepidermal bullae with intense cutaneous pruritus.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001058_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001058_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Underlying systemic lupus erythematosus with extensive autoantibody repertoire and defective clearance of apoptotic material.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001058_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001058_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Development of high-affinity IgG autoantibodies specifically targeting type VII collagen within the anchoring fibrils of the basement membrane zone.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001058_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001058_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Anti-type VII collagen antibodies deposit in a continuous linear or granular pattern along the sub-lamina densa.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001058_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001058_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activation of complement and intense infiltration of polymorphonuclear neutrophils along the dermo-epidermal junction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001058_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001058_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Neutrophil elastase degrades anchoring fibrils, resulting in dermo-epidermal separation, extensive tense bullae, and mucosal erosions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001059_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001059_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immune dysregulation in children or adults leads to loss of tolerance against nuclear matrix protein 2 (NXP2/MORC3).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001059_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001059_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B-cell activation produces specific anti-NXP2 autoantibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001059_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001059_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deposition of immune complexes and complement activation (C5b-9) within intramuscular and dermal microvasculature.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001059_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001059_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Ischemia of perifascicular muscle fibers, pericyte loss, and chronic perifascicular muscle atrophy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001059_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001059_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Widespread muscle ischemia, severe weakness, and extensive dystrophic subcutaneous and myofascial calcinosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001060_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001060_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Strong genetic association with HLA-DQB1*06:02 coupled with post-infectious molecular mimicry (influenza A H1N1, Streptococcus).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001060_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001060_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primed autoreactive CD4+ and CD8+ cytotoxic T cells breach the blood-brain barrier into the lateral hypothalamus.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001060_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001060_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>T cells specifically target and destroy hypocretin (orexin)-producing neurons via perforin/granzyme cytotoxicity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001060_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001060_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Selective, near-complete depletion (&gt;90%) of hypocretinergic neurons in the tuberal lateral hypothalamus.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001060_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001060_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of hypothalamic hypocretin signaling disrupts sleep-wake stabilization and REM sleep gating, producing excessive daytime sleepiness and cataplexy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001061_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001061_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dietary ingestion of gluten in HLA-DQ2/DQ8 genetically susceptible individuals exposes resistant 33-mer gliadin peptides.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001061_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001061_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>In the lamina propria, tissue transglutaminase 2 (tTG-2) deamidates gliadin peptides, creating negatively charged epitopes with high HLA-DQ2/DQ8 affinity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001061_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001061_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dendritic cells present deamidated gliadin to CD4+ T helper cells, triggering secretion of IFN-γ and stimulating B cells to produce anti-tTG and anti-DGP antibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001061_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001061_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Epithelial stress upregulates IL-15, which reprograms intraepithelial lymphocytes (CD8+ IELs) into natural killer-like cytotoxic cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001061_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001061_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>IEL-mediated lysis of enterocytes via NKG2D/MIC interactions causes diffuse villous atrophy, crypt hyperplasia, and malabsorption.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001062_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001062_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe acute viral/bacterial infection (EBV, enterovirus, SARS-CoV-2) triggers prolonged innate and adaptive neuroimmune activation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001062_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001062_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Sustained microglial activation, brainstem neuroinflammation, and autonomic nervous system dysregulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001062_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001062_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Impaired cellular bioenergetics characterized by mitochondrial dysfunction, defective oxidative phosphorylation, and cellular energy deficit.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001062_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001062_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Endothelial dysfunction, platelet microclots, and diminished microvascular tissue perfusion during physical exertion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001062_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001062_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inability to meet metabolic demands upon exertion results in debilitating post-exertional malaise (PEM), chronic unrefreshing sleep, and cognitive dysfunction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001063_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001063_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding immune perturbation primes autoreactive CD4+ Th1/Th17 cells and B cells against peripheral nerve myelin antigens (P0, P2, PMP22).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001063_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001063_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Effector T cells and antibodies cross a permeabilized blood-nerve barrier into spinal roots and peripheral nerves.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001063_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001063_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Macrophages infiltrate the endoneurium, stripping myelin sheaths from Schwann cells under antibody and complement mediation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001063_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001063_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Repeated, chronic cycles of demyelination and Schwann cell proliferation lead to concentric &quot;onion bulb&quot; formation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001063_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001063_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive secondary axonal loss, conduction block, and sensorimotor impairment cause symmetric proximal and distal polyradiculoneuropathy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001064_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001064_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primary urothelial insult, toxic urinary solutes, or neurogenic triggers breach the protective glycosaminoglycan (GAG) apical umbrella cell layer.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001064_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001064_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Urinary potassium and hyperosmolar solutes penetrate the deep suburothelium, inducing chronic chemical irritation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001064_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001064_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive recruitment and degranulation of submucosal mast cells release histamine, leukotrienes, and substance P.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001064_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001064_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Suburothelial neurogenic inflammation promotes C-fiber nociceptive upregulation and central sensitization.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001064_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001064_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Bladder wall fibrosis, Hunner&apos;s lesions, and persistent detrusor pain result in extreme frequency, urgency, and pelvic pain.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001065_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001065_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primary infection with Borrelia burgdorferi triggers widespread immune and inflammatory activation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001065_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001065_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Successful antimicrobial clearance leaves persistent microbial peptidoglycans/antigens, cross-reactive autoantibodies, or persistent neuroinflammation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001065_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001065_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic low-grade activation of peripheral immune cells and central nervous system microglia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001065_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001065_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autonomic nervous system dysregulation, altered pain processing, and central sensitization of nociceptive pathways.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001065_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001065_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Sustained fatigue, generalized musculoskeletal pain, sleep disturbances, and cognitive &quot;brain fog&quot; despite negative bacterial cultures.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001066_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001066_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dysregulation in IL-10 transcription combined with hyperactive innate immune signaling in osteoclasts and monocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001066_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001066_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Excessive production of pro-inflammatory cytokines, particularly IL-1β, TNF-α, and IL-6, without infectious pathogens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001066_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001066_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Hyperactivation and uncoupled recruitment of osteoclasts within metaphyses of long bones, clavicle, and spine.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001066_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001066_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Osteoclast-mediated lytic bone resorption followed by reactive osteoblastic bone remodeling and periostitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001066_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001066_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Recurrent sterile, painful multifocal inflammatory bone lesions and progressive skeletal deformities.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001067_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001067_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primary SARS-CoV-2 infection leads to viral antigen/RNA persistence, latent herpesvirus reactivation (EBV), or immune dysregulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001067_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001067_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic systemic inflammation and emergence of functional autoantibodies (against GPCRs, interferons, or nuclear antigens).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001067_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001067_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Persistent endothelial dysfunction, microvascular endotheliitis, and formation of amyloid fibrin microclots impair capillary perfusion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001067_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001067_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Microglial activation and neuroinflammation in the brainstem, autonomic nuclei, and vagus nerve.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001067_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001067_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Persistent multi-organ impairment manifesting as severe post-exertional fatigue, dysautonomia/POTS, respiratory distress, and cognitive deficits.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001068_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001068_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding upper respiratory infection initiates an autoimmune response against inner ear and ocular antigens (CD148/DEP-1, cochlin).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001068_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001068_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of autoantibodies directed against inner ear sensory tissue and corneal stromal components.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001068_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001068_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dense lymphocytic, histiocytic, and plasma cell infiltration of the cornea and inner ear membranous labyrinth.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001068_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001068_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Interstitial keratitis, perilymphatic inflammation, endolymphatic hydrops, and destruction of cochlear hair cells and spiral ganglion neurons.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001068_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001068_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Development of bilateral non-syphilitic interstitial keratitis accompanied by acute, profound sensorineural hearing loss and vestibular dysfunction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001069_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001069_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of B cells (typically low-grade B-cell lymphoproliferative disorder) with restricted IGHV4-34 gene usage.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001069_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001069_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of monoclonal IgM autoantibodies (cold agglutinins) specific for the branched I carbohydrate antigen on red blood cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001069_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001069_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>In cooler peripheral microvasculature (acral beds, &lt;37°C), IgM binds the erythrocyte I antigen and fixes complement C1q.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001069_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001069_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Classical complement cascade activates C3b deposition; upon warming to core body temperature, IgM detaches, leaving C3b-coated erythrocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001069_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001069_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Hepatic Kupffer cells phagocytose C3b-opsonized erythrocytes (extravascular hemolysis) with occasional terminal C5b-9 intravascular lysis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001070_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001070_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autosomal recessive loss-of-function mutations in the LRBA gene abolish lipopolysaccharide-responsive beige-like anchor protein.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001070_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001070_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Lack of LRBA halts normal endosomal recycling of CTLA-4, causing rapid CTLA-4 lysosomal degradation in regulatory T cells (Tregs).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001070_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001070_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe loss of cell-surface CTLA-4 impairs Treg suppressive function, allowing uncontrolled activation of effector T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001070_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001070_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ and CD8+ T-cell expansion causes multi-organ infiltration alongside progressive B-cell depletion and hypogammaglobulinemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001070_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001070_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe multi-system autoimmunity (autoimmune enteropathy, hemolytic anemia, thrombocytopenia) and susceptibility to recurrent infections.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001071_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001071_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Minor extremity trauma, fracture, or surgery triggers exaggerated local release of pro-inflammatory neuropeptides (substance P, CGRP).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001071_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001071_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies against autonomic receptors (β2-adrenergic and M2 muscarinic) develop or amplify sympathetic reactivity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001071_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001071_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Microvascular endothelial dysfunction induces persistent deep-tissue ischemia, local hypoxia, and respiratory burst.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001071_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001071_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Spinal cord dorsal horn sensitization and persistent microglial activation amplify central nociceptive transmission.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001071_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001071_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic neuropathic burning pain, autonomic sudomotor/vasomotor instability, edema, and progressive trophic dystrophic tissue changes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001072_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001072_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autosomal dominant missense mutation in the COPA gene, encoding the α-subunit of coatomer protein complex I (COP-I).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001072_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001072_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Defective COP-I impairs retrograde protein transport from the Golgi apparatus back to the endoplasmic reticulum (ER).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001072_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001072_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>ER stress and accumulation of misfolded proteins activate the STING (stimulator of interferon genes) pathway.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001072_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001072_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Robust, constitutive transcription and systemic secretion of type I interferons (IFN-α/β) and pro-inflammatory cytokines.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001072_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001072_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe pulmonary alveolar hemorrhage/interstitial lung disease, inflammatory arthritis, and immune complex glomerulonephritis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001073_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001073_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (NOD2/CARD15, ATG16L1, IL23R) combined with environmental triggers and gut dysbiosis impairs mucosal barrier function.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001073_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001073_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Translocation of luminal commensal microbiota into the bowel wall triggers aberrant innate and dendritic cell activation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001073_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001073_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Skewed polarization of naive T cells into mucosal CD4+ Th1 (IFN-γ, TNF-α) and Th17 (IL-17, IL-22) effector subsets.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001073_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001073_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transmural infiltration of lymphocytes, macrophages, and neutrophils across all layers of the intestinal wall, forming non-caseating granulomas.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001073_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001073_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deep ulcerations, cobblestoning, transmural fissure formation, fistulas, and fibromuscular strictures throughout the gastrointestinal tract.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001074_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001074_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unidentified alveolar epithelial injury (idiopathic, toxic, or viral trigger) damages the basement membrane.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001074_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001074_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Influx of plasma proteins and fibrin into the alveolar spaces with intense recruitment of inflammatory monocytes and lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001074_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001074_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Proliferation of intra-alveolar fibroblasts and myofibroblasts, forming loose connective tissue plugs (Masson bodies).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001074_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001074_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deposition of immature collagen and proteoglycans within respiratory bronchioles, alveolar ducts, and adjacent alveoli.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001074_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001074_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Patchy air-space consolidation, restrictive ventilatory impairment, and hypoxemia without architectural architectural remodeling.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001075_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001075_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Heterozygous loss-of-function mutation in the CTLA4 gene impairs cytotoxic T-lymphocyte antigen-4 expression on regulatory T cells (Tregs).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001075_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001075_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Failure of Tregs to trans-endocytose CD80/CD86 from antigen-presenting cells results in loss of cell-extrinsic immune checkpoint inhibition.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001075_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001075_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unrestricted co-stimulation via CD28 drives hyperactivation and proliferation of self-reactive conventional CD4+ and CD8+ T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001075_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001075_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic hyperimmune activation promotes germinal center hyperplasia, polyclonal B-cell dysregulation, and tissue lymphocytic infiltration.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001075_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001075_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Multisystem lymphocytic infiltration (lungs, gut, CNS), progressive hypogammaglobulinemia, and recurrent autoimmune cytopenias.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001076_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001076_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic predisposition and ultraviolet (UV) radiation induce widespread DNA damage and apoptosis of basal keratinocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001076_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001076_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Defective clearance of apoptotic debris exposes intracellular Ro/SSA, La/SSB, and nucleosomal autoantigens to dendritic cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001076_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001076_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Plasmacytoid dendritic cells produce high levels of type I interferons (IFN-α), upregulating CXCL9/CXCL10 chemokines.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001076_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001076_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of CXCR3+ cytotoxic CD8+ T cells and plasmacytoid cells along the dermal-epidermal junction (interface dermatitis).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001076_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001076_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Liquefaction degeneration of the basal layer, follicular plugging, dermal edema, and scarring discoid or non-scarring subacute cutaneous lesions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001077_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001077_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Somatic activating gain-of-function mutations in the KIT receptor tyrosine kinase gene (most commonly KIT D816V).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001077_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001077_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Constitutive, ligand-independent autophosphorylation of KIT drives unchecked clonal proliferation and survival of mast cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001077_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001077_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal mast cells migrate to and selectively accumulate in high density within the papillary and reticular dermis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001077_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001077_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Physical stimuli (rubbing, temperature change, pressure) trigger mechanical or IgE-independent mast cell degranulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001077_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001077_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive release of histamine, tryptase, and prostaglandins causes Darier&apos;s sign, pruritus, flushing, and pigmented maculopapular urticaria pigmentosa.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001078_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001078_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dietary gluten ingestion in individuals with celiac disease (HLA-DQ2/DQ8) drives gut mucosal IgA production against tissue transglutaminase.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001078_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001078_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Epitope spreading and B-cell clonal maturation produce high-affinity IgA autoantibodies targeting epidermal transglutaminase (eTG / TG3).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001078_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001078_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating IgA anti-eTG antibodies form immune complexes with epidermal transglutaminase.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001078_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001078_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complexes deposit selectively in a granular pattern within the dermal papillae just beneath the basement membrane zone.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001078_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001078_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Granular IgA deposits activate the alternative complement pathway (C5a), recruiting neutrophils that form microabscesses and subepidermal blisters with intense pruritus.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001079_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001079_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-DRB1*03:01) combined with viral/environmental triggers or malignancy initiates an immune response against endothelial targets.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001079_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001079_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Plasmacytoid dendritic cells produce massive quantities of type I interferons (IFN-α/β), creating an intense interferon-stimulated gene signature.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001079_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001079_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies (anti-Mi-2, anti-TIF1-γ, anti-NXP2) and complement component C3 activate, forming the membrane attack complex (C5b-9).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001079_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001079_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deposition of C5b-9 on endomysial microvascular capillary endothelial cells causes endothelial swelling, microthrombi, and capillary loss.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001079_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001079_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Perivascular inflammation, perifascicular ischemia, perifascicular muscle fiber atrophy, and characteristic cutaneous eruptions (heliotrope rash, Gottron papules).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001081_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001081_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Small cell lung carcinoma expressing functional voltage-gated calcium channels (paraneoplastic) or primary autoimmune dysregulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001081_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001081_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of high-affinity IgG autoantibodies directed against P/Q-type voltage-gated calcium channels (VGCC) on presynaptic membranes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001081_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001081_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies cross-link presynaptic P/Q-type VGCCs at the neuromuscular junction, inducing receptor internalization and reduction in channel density.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001081_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001081_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Action potential arrival fails to trigger sufficient presynaptic calcium influx.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001081_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001081_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Defective calcium-dependent exocytosis of acetylcholine into the synaptic cleft causes proximal muscle weakness, hyporeflexia, and autonomic dysfunction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001082_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001082_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Triggering viral encephalitis or paraneoplastic tumor stimulates immune response against GABA_A receptor subunits.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001082_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001082_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of high-titer autoantibodies targeting the extracellular domains of the GABA_A receptor (predominantly α1, β3, or γ2).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001082_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001082_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Intrathecal and systemic autoantibodies bind synaptic and extrasynaptic GABA_A receptors on cortical and hippocampal neurons.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001082_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001082_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibody cross-linking promotes receptor downregulation, selective internalization, and marked decrease in GABAergic inhibitory currents.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001082_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001082_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe reduction in GABAergic inhibition induces cortical hyperexcitability, leading to refractory status epilepticus, cognitive dysfunction, and extensive cortical MRI hyperintensities.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001083_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001083_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Strong genetic association with HLA-DRB1*10:01 and HLA-DQB1*05:01 initiates an immune response against neuronal cell-adhesion molecule IgLON5.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001083_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001083_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>High-affinity IgG4 (and IgG1) autoantibodies are generated against extracellular IgLON5 domains.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001083_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001083_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Intrathecal IgG4 antibodies bind surface IgLON5 on brainstem, hypothalamic, and hippocampal neurons, promoting irreversible endocytosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001083_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001083_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Disruption of cell adhesion cascades and cytoskeletal maintenance induces abnormal phosphorylation and accumulation of 3R and 4R tau protein.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001083_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001083_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Widespread neurodegenerative tauopathy in the tegmentum, brainstem, and hypothalamus results in severe sleep apnea, parasomnias, bulbar dysfunction, and autonomic instability.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001084_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001084_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Retrograde menstruation delivers viable endometrial glandular and stromal cells into the peritoneal cavity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001084_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001084_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dysfunctional peritoneal immune surveillance with defective cytotoxic T cells and impaired natural killer (NK) cell clearance.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001084_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001084_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Peritoneal macrophages undergo alternative activation, secreting abundant IL-1β, IL-6, TNF-α, and VEGF.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001084_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001084_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Ectopic endometrial tissue adheres, invades the peritoneal mesothelium, and establishes robust neoangiogenesis and neurogenesis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001084_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001084_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic cyclic inflammation, tissue remodeling, adhesions, and pelvic fibrosis cause chronic dysmenorrhea, pelvic pain, and infertility.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001085_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001085_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Biomechanical repetitive tensile stress at fibrocartilaginous tendon/ligament insertion points into bone induces microdamage.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001085_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001085_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activation of tissue-resident stromal cells and innate immune cells (γδ T cells, ILC3s) in the vascularized enthesis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001085_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001085_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Locally released IL-23 promotes profound autocrine and paracrine secretion of IL-17A, IL-22, and TNF-α.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001085_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001085_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inflammatory cytokine cascade recruits neutrophils and osteoclasts, causing focal osteitis and subchondral bone erosions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001085_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001085_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Subsequent IL-22- and BMP-driven bone remodeling leads to new periosteal bone formation, enthesophytes, and calcification.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001086_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001086_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Food or aeroallergen exposure in genetically susceptible individuals (calpain-14, CAPN14, eotaxin-3 variants) compromises the esophageal mucosal barrier.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001086_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001086_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Esophageal epithelial cells release alarmins (TSLP, IL-33), driving an allergen-specific CD4+ Th2 immune response.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001086_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001086_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Th2 cells secrete large quantities of IL-4, IL-5, and IL-13, stimulating epithelial eotaxin-3 (CCL26) expression.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001086_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001086_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Marked recruitment, transmigration, and intraepithelial accumulation of eosinophils into esophageal squamous epithelium (&gt;15 eosinophils/HPF).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001086_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001086_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Eosinophil degranulation (major basic protein, eosinophil peroxidase) and TGF-β release drive basal zone hyperplasia, lamina propria fibrosis, rings, and strictures.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001087_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001087_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Neural autoantigen expression in systemic tumors, post-viral encephalitis, or idiopathic autoimmunity activates B and T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001087_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001087_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pathogenic autoantibodies (anti-LGI1, anti-NMDAR, anti-GABA_B, anti-GAD65) and/or cytotoxic CD8+ T cells cross the blood-brain barrier.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001087_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001087_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Binding of cell-surface ion channels/receptors downregulates inhibitory GABAergic pathways or hyperactivates glutamatergic transmission.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001087_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001087_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Neuronal hyperexcitability, synchronized paroxysmal depolarizations, and microglial inflammation in neocortical and hippocampal networks.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001087_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001087_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Intractable epileptic seizures, status epilepticus, and progressive neurocognitive decline refractory to standard anti-seizure medications.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001088_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001088_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Idiopathic localized immune activation or association with underlying systemic autoimmune disorders (rheumatoid arthritis, IBD, relapsing polychondritis).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001088_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001088_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deposition of circulating immune complexes or local activation of perivascular dendritic cells in the superficial episcleral plexus.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001088_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001088_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Recruitment of T lymphocytes, monocytes, and neutrophils with release of histamine and inflammatory cytokines.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001088_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001088_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Vasodilation and increased permeability of the superficial episcleral capillary network with localized perivascular edema.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001088_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001088_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Sectoral or diffuse episcleral hypervascular injection, mild discomfort, and chemosis without scleral thinning or vision loss.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001089_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001089_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Exposure to infectious antigens (Streptococcus, tuberculosis), medications (sulfonamides, oral contraceptives), or sarcoidosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001089_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001089_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Type IV delayed-type hypersensitivity reaction with immune complex deposition in the septal venules of subcutaneous fat.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001089_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001089_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Recruitment of CD4+ Th1 lymphocytes and neutrophils releasing TNF-α, IL-6, and reactive oxygen species.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001089_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001089_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Acute inflammation of the interlobular septa of subcutaneous adipose tissue (septal panniculitis) without true vasculitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001089_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001089_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extravasation of red blood cells, histiocytic granulomatous inflammation (Miescher radial granulomas), and tender, erythematous subcutaneous nodules.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001090_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001090_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic stimulation of B-cell clones (predominantly driven by chronic Hepatitis C virus infection or idiopathic clonal expansion).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001090_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001090_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of monoclonal IgM rheumatoid factors that bind the Fc portion of polyclonal IgG to form cryoprecipitable immune complexes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001090_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001090_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cold temperature promotes reversible precipitation of IgM-IgG cryoglobulins in cooler peripheral and visceral microvasculature.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001090_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001090_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cryoglobulin complexes deposit in small vessel walls, binding endothelial cells and fixing classical complement (C1q, C3a, C5a).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001090_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001090_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Leukocytoclastic vasculitis, microvascular thrombosis, and ischemic necrosis cause palpable purpura, arthralgias, peripheral neuropathy, and membranoproliferative glomerulonephritis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001091_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001091_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Simultaneous or sequential breakdown of immune tolerance against both erythroid and megakaryocyte/platelet lineage autoantigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001091_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001091_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B cells produce warm IgG autoantibodies against red blood cells (Rh complex) and platelets (GPIIb/IIIa).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001091_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001091_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Concurrent opsonization of circulating erythrocytes and platelets with IgG and complement fragments.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001091_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001091_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Fcγ receptor-mediated phagocytosis and destruction by splenic and hepatic reticuloendothelial macrophages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001091_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001091_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe, life-threatening combination of autoimmune hemolytic anemia (AIHA) and immune thrombocytopenia (ITP).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001092_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001092_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Strenuous physical exertion, microtrauma, or toxic/antigenic exposure triggers deep fascial immune hyperactivation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001092_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001092_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Marked upregulation of IL-5, TGF-β, and eotaxin drives systemic and tissue eosinophilia alongside CD4+ T-cell activation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001092_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001092_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the deep fascia, subcutis, and perimysium by eosinophils, lymphocytes, and histiocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001092_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001092_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Eosinophil degranulation releases toxic cationic proteins, stimulating intense fibroblast collagen production.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001092_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001092_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive fibrotic thickening and sclerosis of the deep fascia cause characteristic symmetrical skin induration, &quot;groove sign,&quot; and joint contractures.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001093_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001093_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Longstanding, severe seropositive rheumatoid arthritis with high titers of rheumatoid factor (RF) and anti-CCP antibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001093_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001093_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal proliferation of large granular lymphocytes (CD3+/CD8+ or CD57+ T-LGLs) and production of antineutrophil antibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001093_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001093_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deposition of immune complexes and autoantibody opsonization of peripheral neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001093_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001093_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Accelerated splenic sequestration and destruction of neutrophils combined with bone marrow granulopoiesis suppression via excess IFN-γ and Fas/FasL signaling.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001093_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001093_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Triad of deforming rheumatoid arthritis, marked splenomegaly, and severe neutropenia leading to serious recurrent bacterial infections.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001094_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001094_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Disruption of mucosal immune tolerance in the female reproductive tract following trauma, infection, or semen exposure.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001094_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001094_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Local mucosal and systemic B cells produce antisperm antibodies (ASAs) of IgG and IgA classes targeting sperm surface antigens (SP-10, Izumo1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001094_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001094_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Secretion of ASAs into cervical mucus, uterine lumen, and follicular/fallopian fluid.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001094_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001094_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>ASAs bind to motile spermatozoa, agglutinating them, immobilizing them, or activating complement-mediated sperm lysis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001094_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001094_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Impaired sperm cervical mucus penetration, blocked capacitation, and prevention of sperm-oocyte membrane fusion cause fertilization failure.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001095_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001095_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (serotonergic/catecholaminergic gene polymorphisms) and environmental stressors, trauma, or infections.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001095_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001095_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Aberrant central pain processing characterized by dorsal horn wind-up, reduced descending inhibitory pathways, and central sensitization.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001095_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001095_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Low-grade systemic and neurogenic inflammation with elevated CSF substance P, nerve growth factor, and microglial activation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001095_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001095_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Peripheral small-fiber pathology, reducing intraepidermal nerve fiber density in a subset of patients.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001095_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001095_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Widespread chronic musculoskeletal allodynia, hyperalgesia, profound fatigue, cognitive dysfunction, and non-restorative sleep.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001096_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001096_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (HLA-DR3, CTLA4, PTPN22) and environmental factors (iodine, stress, smoking) break tolerance against the thyroid-stimulating hormone receptor (TSHR).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001096_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001096_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ T cells stimulate B cells to produce thyroid-stimulating immunoglobulin (TSI / TRAb) autoantibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001096_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001096_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>TSI binds the TSHR on thyroid follicular cells, mimicking TSH and constitutively activating the Gsα-adenylyl cyclase-cAMP signaling pathway.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001096_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001096_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unchecked stimulation induces follicular cell hypertrophy, hyperplasia, vascular proliferation, and excessive secretion of T3 and T4 hormones.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001096_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001096_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Hyperthyroidism, diffuse goiter, pretibial myxedema, and TSHR-mediated orbital fibroblast activation produce Graves&apos; ophthalmopathy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001097_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001097_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding gastrointestinal or respiratory infection (Campylobacter jejuni, CMV, EBV) with microbial antigens displaying ganglioside-like epitopes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001097_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001097_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Molecular mimicry drives synthesis of high-affinity IgG autoantibodies against peripheral nerve gangliosides (GM1, GD1a, GQ1b).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001097_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001097_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies penetrate the permeable blood-nerve barrier at nerve roots and distal terminals.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001097_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001097_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complement activation (C3b, C5b-9) and macrophage recruitment promote complement-mediated lysis or macrophage invasion of Schwann cells and axolemma.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001097_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001097_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Acute demyelination or axonal degeneration produces rapidly ascending flaccid paralysis, areflexia, and respiratory failure.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001099_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001099_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Paternal MHC Class II antigen expression on the placenta during pregnancy triggers maternal alloimmune/autoimmune cross-reactivity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001099_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001099_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of high-affinity maternal IgG1 autoantibodies (&quot;HG factor&quot;) specifically targeting the NC16A domain of BP180 (collagen XVII).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001099_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001099_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cross-reactive autoantibodies bind BP180 in the basement membrane zone of maternal skin and chorionic epithelium.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001099_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001099_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Classical complement pathway activation (avid C3 fixation) recruits and degranulates dermal eosinophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001099_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001099_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Proteolytic cleavage of hemidesmosomes causes dermo-epidermal separation, producing intensely pruritic periumbilical urticarial papules and tense blisters.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001100_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001100_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic variants (γ-secretase pathway: NCSTN, PSENEN) and environmental factors (friction, smoking, obesity) induce follicular infundibular hyperkeratosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001100_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001100_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Occlusion of the terminal hair follicle in intertriginous apocrine gland-rich body regions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001100_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001100_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Bacterial colonization and trapped debris trigger follicular rupture, releasing keratin and DAMPs into the surrounding dermis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001100_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001100_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive innate immune activation with recruitment of neutrophils, macrophages, and Th17 cells releasing IL-1β, TNF-α, and IL-17.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001100_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001100_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic recurrent abscesses, painful inflammatory nodules, dermal sinus tracts, and extensive scarring.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001101_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001101_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Exposure to an inciting antigen (drugs, infections, chemicals) induces synthesis of circulating IgG or IgM antibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001101_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001101_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Antigen-antibody interaction forms soluble immune complexes that deposit within postcapillary venule walls in dependent areas.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001101_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001101_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immune complexes bind Fc receptors and fix complement, generating potent chemoattractants C3a and C5a.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001101_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001101_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Influx and activation of polymorphonuclear neutrophils, which degranulate and release reactive oxygen species and lysosomal proteases.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001101_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001101_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Neutrophil nuclear fragmentation (leukocytoclasia), fibrinoid necrosis of postcapillary venules, and red blood cell extravasation cause palpable purpura.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001102_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001102_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic association with HLA-DQA1*05:01 and PLA2R1 risk variants breaks self-tolerance against podocyte surface antigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001102_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001102_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of high-affinity IgG4 autoantibodies targeting the extracellular domains of phospholipase A2 receptor 1 (PLA2R1) or THSD7A.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001102_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001102_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating autoantibodies cross the glomerular basement membrane (GBM) and bind PLA2R on the foot processes of visceral epithelial cells (podocytes).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001102_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001102_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>In situ immune complex formation activates the sublytic lectin and alternative complement pathways, depositing C5b-9.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001102_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001102_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Podocyte cytoskeleton disruption, reactive GBM matrix overproduction (&quot;spikes&quot;), and slit diaphragm failure cause massive, non-selective nephrotic-range proteinuria.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001103_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001103_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (MUC5B, TERT) and recurrent microinjuries from cigarette smoke or environmental toxins damage alveolar epithelial cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001103_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001103_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic repetitive injury drives premature senescence and apoptosis of type II alveolar epithelial cells (AECs).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001103_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001103_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Aberrant epithelial-mesenchymal crosstalk releases abundant pro-fibrotic mediators, predominantly TGF-β1, PDGF, and FGF.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001103_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001103_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Excessive proliferation and activation of resident fibroblasts into α-SMA-positive myofibroblasts forming &quot;fibroblastic foci.&quot;</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001103_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001103_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unchecked extracellular matrix and collagen deposition destroys alveolar architecture, resulting in honeycomb remodeling and restrictive lung failure.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001104_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001104_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Multi-hit pathogenesis: Aberrant mucosal B-cell response produces elevated circulating galactose-deficient IgA1 (Gd-IgA1) (Hit 1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001104_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001104_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of circulating IgG or IgA autoantibodies directed against the exposed hinge-region O-glycans of Gd-IgA1 (Hit 2).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001104_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001104_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Formation of pathogenic polymeric Gd-IgA1-IgG immune complexes in the systemic circulation (Hit 3).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001104_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001104_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deposition of large immune complexes within the glomerular mesangium, stimulating mesangial cell proliferation and alternative complement pathway activation (Hit 4).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001104_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001104_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Mesangial matrix expansion, podocyte injury, and glomerulosclerosis manifest as recurrent hematuria and progressive renal failure.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001105_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001105_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pharmacological administration of ICI antibodies (anti-PD-1, anti-PD-L1, anti-CTLA-4) blocks key negative regulatory immune checkpoints.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001105_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001105_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Disinhibition and proliferation of previously quiescent, self-reactive CD4+ and CD8+ cytotoxic T lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001105_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001105_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of Treg-mediated peripheral tolerance and downregulation of peripheral tissue protective mechanisms.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001105_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001105_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of self-tissues (colon, liver, endocrine organs, myocardium, nerves) by unrestrained cytotoxic T cells releasing IFN-γ and TNF-α.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001105_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001105_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Rapid immune-mediated cell lysis causes severe immune-related adverse events (irAEs: colitis, hepatitis, hypophysitis, myocarditis).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001106_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001106_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Hemizygous loss-of-function germline mutations in the FOXP3 gene on the X chromosome.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001106_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001106_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Failure of normal development and regulatory function in CD4+ CD25+ FOXP3+ regulatory T cells (Tregs).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001106_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001106_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complete absence of Treg-mediated peripheral suppression permits unrestrained activation of autoreactive CD4+ and CD8+ effector T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001106_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001106_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of multiple organs and hyperactivation of B cells producing multi-organ autoantibodies (anti-enterocyte, anti-islet, anti-thyroid).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001106_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001106_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe multi-organ autoimmune triad in male infants: intractable secretory enteropathy, type 1 diabetes mellitus, and eczematous dermatitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001107_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001107_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of self-tolerance leads to production of IgG autoantibodies against platelet surface glycoproteins (GPIIb/IIIa, GPIb/IX).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001107_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001107_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind to circulating platelets, exposing Fc domains to reticuloendothelial phagocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001107_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001107_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Splenic macrophages recognize opsonized platelets via Fcγ receptors, leading to accelerated receptor-mediated platelet phagocytosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001107_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001107_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Concurrently, autoantibodies and autoreactive CD8+ cytotoxic T cells infiltrate bone marrow, attacking megakaryocytes and suppressing thrombopoiesis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001107_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001107_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Profound peripheral thrombocytopenia impairs primary hemostasis, manifesting as petechiae, purpura, mucosal bleeding, and hemorrhage.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001108_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001108_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Mucosal antigen exposure (upper respiratory or gastrointestinal infection) induces aberrant synthesis of galactose-deficient IgA1 (Gd-IgA1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001108_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001108_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of circulating autoantibodies (IgG or IgA) directed against galactose-deficient IgA1 hinge-region O-glycans.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001108_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001108_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pathogenic polymeric IgA1 immune complexes form in the circulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001108_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001108_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immune complexes deposit in small blood vessels of the skin, gastrointestinal tract, and renal mesangium.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001108_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001108_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complement activation (C3, lectin/alternative pathway) recruits neutrophils, producing leukocytoclastic vasculitis, palpable purpura, abdominal pain, and glomerulonephritis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001109_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001109_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Antigen presentation (galectin-3, annexin A11, laminin-511-E8) triggers clonal expansion of CD4+ cytotoxic T lymphocytes (CD4+ CTLs) and Tfh cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001109_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001109_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Interleukin secretion (IL-4, IL-10, IL-13) drives somatic hypermutation and massive class-switching to IgG4 in plasmablasts.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001109_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001109_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of affected organs by dense IgG4+ plasma cells and CD4+ CTLs.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001109_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001109_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Secretion of profibrotic cytokines (TGF-β, IL-1β) by infiltrating cells and macrophages activates resident myofibroblasts.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001109_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001109_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Storiform fibrosis, obliterative phlebitis, and dense lymphoplasmacytic infiltrates cause tumefactive tissue swelling and organ dysfunction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001110_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001110_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immune triggers stimulate CD4+ cytotoxic T lymphocytes and T follicular helper (Tfh) cells in orbital connective tissue.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001110_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001110_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Robust secretion of IL-4, IL-10, and IL-13 drives massive class-switching to IgG4 in expanding plasmablasts and plasma cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001110_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001110_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of lacrimal glands, extraocular muscles, and orbital fat by IgG4+ plasma cells and eosinophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001110_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001110_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Release of TGF-β by infiltrating macrophages and regulatory cells initiates characteristic storiform interstitial fibrosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001110_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001110_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive painless orbital pseudo-tumor mass, proptosis, dacryoadenitis, compressive optic neuropathy, and diplopia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001111_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001111_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (HLA-DRB1*03:01) coupled with cellular aging leads to dual autoimmune and degenerative processes in skeletal muscle.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001111_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001111_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion and endomysial infiltration of antigen-driven CD8+ cytotoxic T cells and CD28-null effector T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001111_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001111_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>CD8+ T cells surround and invade non-necrotic muscle fibers expressing MHC Class I (HLA-ABC) on their sarcolemma.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001111_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001111_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cytotoxic granule release (perforin, granzyme B) induces myofiber injury, while impaired protein degradation pathways lead to accumulation of phosphorylated tau, amyloid-β, and TDP-43 aggregates.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001111_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001111_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive myofiber loss, rimmed vacuole formation, and endomysial fibrosis produce asymmetric proximal and distal muscle atrophy and dysphagia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001112_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001112_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of intestinal epithelial tight junctions in genetically susceptible hosts allows excessive penetration of luminal gut microbiota.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001112_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001112_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Innate pattern recognition receptors (TLRs, NOD2) activate mucosal dendritic cells and macrophages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001112_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001112_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pathological differentiation of naive CD4+ T cells into mucosal Th1, Th2-like, and Th17 inflammatory subsets.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001112_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001112_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive secretion of pro-inflammatory cytokines (TNF-α, IL-1β, IL-6, IL-12/23, IL-17) recruits circulating neutrophils and monocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001112_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001112_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe mucosal and transmural tissue destruction, ulceration, architectural distortion, and impaired water and nutrient absorption.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001113_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001113_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Exposure to sulfhydryl-containing medications or viral illness in individuals possessing the high-risk HLA-DRB1*04:06 allele.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001113_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001113_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of immunological tolerance against native, endogenous human insulin without prior exogenous insulin therapy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001113_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001113_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of B cells produces high titers of polyclonal IgG autoantibodies directed against native insulin.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001113_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001113_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>In the postprandial state, secreted insulin binds avidly to circulating autoantibodies, delaying initial glucose disposal and causing early hyperglycemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001113_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001113_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Subsequent unpredictable, spontaneous dissociation of vast amounts of free insulin from autoantibody complexes triggers profound, life-threatening reactive hypoglycemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001114_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001114_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Systemic autoimmune disease (often SLE) or immune dysregulation stimulates clonal B cells against the insulin receptor.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001114_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001114_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of high-titer polyclonal IgG autoantibodies directed against the extracellular α-subunit of the insulin receptor (INSR).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001114_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001114_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind the insulin-binding pocket of INSR on target tissues (liver, muscle, adipose), competitively blocking insulin binding.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001114_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001114_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Failure of insulin signaling prevents GLUT4 translocation and downstream metabolic cascades, creating profound, intractable insulin resistance.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001114_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001114_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extreme hyperinsulinemia, severe refractory hyperglycemia, and diffuse acanthosis nigricans, alternating unpredictably with paradoxically stimulatory hypoglycemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001115_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001115_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of ocular immune tolerance triggered by systemic disease (multiple sclerosis, sarcoidosis) or idiopathic autoantigen presentation (retinal S-antigen, IRBP).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001115_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001115_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primed CD4+ Th1 and Th17 cells cross the blood-ocular barrier into the vitreous base and ciliary body.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001115_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001115_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic perivascular infiltration around peripheral retinal venules (periphlebitis).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001115_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001115_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Vitreous condensation, cellular aggregation (&quot;snowballs&quot;), and fibrovascular exudation over the pars plana and inferior ora serrata (&quot;snowbanks&quot;).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001115_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001115_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Vitreous opacification, cystoid macular edema (CME), and tractional retinal detachment cause painless floaters and progressive visual impairment.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001116_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001116_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk and environmental/autoimmune insults injure alveolar capillary endothelial and epithelial cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001116_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001116_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Persistent activation of autoreactive CD4+ T cells and B cells (associated with myositis antibodies, Scl-70, or ANA).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001116_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001116_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Mononuclear cell infiltration into the alveolar septa and sustained release of pro-fibrotic cytokines (TGF-β1, IL-4, IL-13, PDGF).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001116_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001116_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Uninhibited differentiation of resident lung fibroblasts into contractile myofibroblasts.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001116_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001116_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive collagen deposition, alveolar wall thickening, and fibrotic architectural distortion severely impair pulmonary alveolar gas exchange.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001117_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001117_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complex genetic susceptibility (HLA-DRB1 alleles, PTPN22) and environmental triggers activate synovial dendritic cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001117_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001117_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of synovial tissue by autoreactive CD4+ Th1/Th17 lymphocytes, macrophages, and B cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001117_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001117_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Secretion of pro-inflammatory cytokines (TNF-α, IL-1β, IL-6, IL-17) induces marked synovial microvascular angiogenesis and lining cell hyperplasia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001117_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001117_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Formation of invasive synovial pannus tissue that adheres to cartilage and subchondral bone.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001117_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001117_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pannus-derived matrix metalloproteinases and osteoclast activation degrade articular cartilage and cause bony erosions, joint stiffness, and chronic pain.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001118_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001118_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Viral infection (e.g., Hepatitis C), drugs, contact allergens, or stress triggers expression of altered autoantigens on basal keratinocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001118_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001118_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Langerhans cells process and present antigens, recruiting antigen-specific CD4+ Th1 and cytotoxic CD8+ T cells to the dermo-epidermal junction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001118_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001118_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltrating cytotoxic CD8+ T cells release perforin, granzyme B, and TNF-α, engaging Fas on basal keratinocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001118_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001118_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Liquefactive degeneration and extensive apoptosis of basal epidermal/mucosal keratinocytes, forming apoptotic Civatte bodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001118_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001118_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dense, band-like (&quot;lichenoid&quot;) lymphocytic infiltration at the dermal-epidermal junction produces pruritic, polygonal, violaceous, flat-topped papules (Wickham&apos;s striae).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001119_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001119_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-DQ7) combined with microtrauma, Koebner phenomenon, or hormonal factors induces cutaneous autoimmunity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001119_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001119_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Development of autoantibodies against extracellular matrix protein 1 (ECM1) and BP180.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001119_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001119_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the upper dermis by activated CD4+ and cytotoxic CD8+ T lymphocytes producing IFN-γ and TNF-α.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001119_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001119_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Lymphocytic destruction of basal keratinocytes and chronic activation of dermal fibroblasts via altered ECM1-fibulin-1 interactions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001119_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001119_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Marked subepidermal edema, homogenization and sclerosis of dermal collagen, and epidermal atrophy lead to genital porcelain-white plaques, pruritus, and scarring.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001120_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001120_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Congenital homozygous or compound heterozygous mutations in the PLG gene, or autoantibodies causing severe type I plasminogen deficiency.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001120_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001120_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Local minor microtrauma or infection triggers normal fibrin deposition and mucosal wound healing response.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001120_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001120_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Marked lack of plasminogen prevents conversion to active plasmin, abolishing physiological intravascular and extravascular fibrinolysis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001120_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001120_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Fibrin accumulates unchecked on ocular mucous membranes, forming thick, dense, insoluble fibrin-rich coagula.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001120_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001120_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Formation of hard, wood-like (&quot;ligneous&quot;), yellowish pseudomembranes on palpebral conjunctiva, causing chronic mucosal ulceration and corneal scarring.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001122_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001122_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Idiopathic autoimmune breakdown or neoplastic trigger leads to the generation of autoantibodies against dipeptidyl peptidase-like protein-6 (DPPX).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001122_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001122_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Plasmablasts synthesize pathogenic IgG autoantibodies targeting DPPX, a regulatory subunit of neuronal Kv4.2 potassium channels.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001122_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001122_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies penetrate the blood-brain barrier and enteric nervous system, binding DPPX on neuronal membranes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001122_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001122_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Functional downmodulation and internalisation of DPPX and Kv4.2 channels attenuate transient A-type potassium currents.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001122_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001122_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of neuronal repolarization causes widespread central and enteric nervous system hyperexcitability, manifesting as severe gastrointestinal motility disorders (diarrhea, weight loss), myoclonus, tremor, and cognitive dysfunction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001123_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001123_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>HLA-DRB1*07:01-linked loss of tolerance prompts an autoimmune attack against secreted leucine-rich glioma-inactivated 1 (LGI1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001123_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001123_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of pathogenic IgG4 autoantibodies targeting LGI1 in the central nervous system.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001123_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001123_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Anti-LGI1 autoantibodies disrupt the trans-synaptic bridging complex between presynaptic ADAM22 and postsynaptic ADAM23.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001123_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001123_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Disruption reduces presynaptic Kv1.1 potassium channel clustering and downregulates postsynaptic AMPA receptors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001123_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001123_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Altered synaptic transmission in hippocampal and motor circuits produces characteristic faciobrachial dystonic seizures (FBDS), memory deficits, and limbic encephalitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001124_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001124_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Drug exposure (frequently vancomycin) or idiopathic autoimmunity breaks tolerance against the 120-kDa or 97-kDa shed ectodomains of BP180 (LAD-1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001124_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001124_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B lymphocytes synthesize pathogenic IgA1 autoantibodies targeting LAD-1/BP180 at the basement membrane zone.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001124_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001124_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>IgA autoantibodies deposit in a continuous, linear ribbon-like pattern along the lamina lucida or sub-lamina densa of the dermal-epidermal junction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001124_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001124_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>IgA Fc receptors (FcαRI / CD89) bind and activate polymorphonuclear neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001124_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001124_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Neutrophil elastase and gelatinase release causes dermo-epidermal separation, manifesting as tense annular blisters in a &quot;string of pearls&quot; configuration.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001125_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001125_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Postulated genetic vulnerability, metabolic dysfunction, or autoimmune microangiopathy in subcutaneous adipose tissue.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001125_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001125_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Low-grade chronic immune infiltration by macrophages and mast cells within subcutaneous fat lobules.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001125_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001125_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Sustained secretion of inflammatory mediators (substance P, IL-6, TNF-α) and microvascular endothelial dysfunction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001125_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001125_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Compression of unmyelinated sensory nerve fibers by proliferating, encapsulated fatty nodules alongside local neurogenic inflammation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001125_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001125_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Formation of multiple painful, tender lipomas, widespread chronic neuropathic adiposis dolorosa, and associated asthenia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001126_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001126_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>In patients with systemic lupus erythematosus, circulating antibodies to dsDNA, Sm, and C1q form abundant immune complexes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001126_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001126_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immune complexes deposit in the walls of small and medium arteries, arterioles, and postcapillary venules.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001126_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001126_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Classical complement pathway activation produces chemotactic anaphylatoxins (C3a, C5a) that recruit and activate neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001126_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001126_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltrating neutrophils release lysosomal proteases and reactive oxygen species, inducing transmural fibrinoid necrosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001126_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001126_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Endothelial denudation, secondary thrombosis, and vascular lumen occlusion lead to cutaneous ulcerations, digital gangrene, visceral infarcts, and mononeuritis multiplex.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001127_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001127_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Disruption of the physiological blood-testis barrier by testicular trauma, torsion, infection (orchitis), or vasectomy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001127_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001127_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extravasation of previously sequestered sperm antigens activates naive immunocompetent lymphocytes in local lymph nodes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001127_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001127_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of sperm-specific autoantibodies (IgG and IgA) directed against sperm head, midpiece, or tail antigens (SP-10, Izumo1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001127_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001127_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind spermatozoa during epididymal transit and ejaculation, coating the sperm surface.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001127_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001127_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Sperm agglutination, reduced forward motility, impaired cervical mucus penetration, and failure of sperm-zona pellucida binding cause male infertility.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001128_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001128_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Luminal triggers (medications such as NSAIDs/PPIs, smoking, luminal toxins) compromise the colonic epithelial barrier in genetically predisposed individuals.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001128_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001128_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of colonic surface epithelium by CD8+ cytotoxic intraepithelial lymphocytes (IELs) and lamina propria by CD4+ Th1 cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001128_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001128_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Secretion of pro-inflammatory cytokines (IFN-γ, TNF-α) impairs epithelial sodium and water absorption and claudin tight junctions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001128_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001128_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>In collagenous colitis, subepithelial fibroblasts synthesize a thick, abnormal band of type I/III collagen (&gt;10 µm) beneath the basement membrane.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001128_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001128_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Impaired fluid reabsorption, increased mucosal permeability, and active chloride secretion produce chronic, non-bloody watery diarrhea.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001129_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001129_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (HLA-DPB1*04:01) and environmental exposures (silica, microbial infections) prime neutrophils via TNF-α and IL-1β.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001129_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001129_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Primed neutrophils express myeloperoxidase (MPO) on their cell surfaces, where it is bound by circulating pANCA (anti-MPO) autoantibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001129_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001129_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>ANCA-mediated cross-linking of Fcγ receptors activates neutrophils, causing degranulation, respiratory burst, and NETosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001129_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001129_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Neutrophil-derived enzymes and alternative complement pathway activation (C5a) destroy small-vessel endothelial cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001129_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001129_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transmural necrotizing pauci-immune vasculitis lacking granulomas causes necrotizing crescentic glomerulonephritis and pulmonary capillaritis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001130_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001130_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of immune tolerance in individuals with HLA-DRB1*04/*15 against the spliceosome U1 small nuclear ribonucleoprotein (U1-snRNP).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001130_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001130_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B-cell activation produces high titers of anti-U1-RNP autoantibodies (against 68/70-kDa, A, and C proteins).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001130_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001130_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of tissues by CD4+ Th1/Th17 lymphocytes alongside widespread immune-complex-mediated microvascular damage.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001130_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001130_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic endothelial injury drives intimal proliferation, medial smooth muscle hypertrophy, and luminal narrowing of small-to-medium vessels.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001130_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001130_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Overlapping features of SLE, systemic sclerosis, and polymyositis manifest as Raynaud&apos;s phenomenon, swollen &quot;puffy&quot; hands, myositis, and pulmonary hypertension.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001131_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001131_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Corneal physical trauma, viral infection, or systemic autoimmunity exposes sequestered corneal stromal-associated antigens (calgranulin C / S100A12).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001131_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001131_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of autoreactive CD4+ Th1 lymphocytes and synthesis of anti-corneal antibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001131_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001131_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Influx of neutrophils, macrophages, and lymphocytes into the peripheral corneal limbus and adjacent episcleral vessels.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001131_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001131_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Release of high concentrations of matrix metalloproteinases (MMP-1, MMP-8, MMP-9) and collagenases by infiltrating cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001131_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001131_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Rapid, progressive ischemic destruction of corneal stroma and deep ulceration beginning at the limbus and spreading circumferentially and centrally.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001132_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001132_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Microvascular injury from trauma, friction, radiation, or infection activates dermal endothelial cells in genetically predisposed hosts.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001132_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001132_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Upregulation of adhesion molecules (ICAM-1, VCAM-1) recruits CD4+ Th2 and Th17 lymphocytes into the reticular dermis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001132_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001132_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Secretion of pro-fibrotic cytokines, predominantly TGF-β, IL-4, and IL-13, stimulates resting dermal fibroblasts.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001132_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001132_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activated fibroblasts transform into α-SMA-positive myofibroblasts, synthesizing excessive type I and III collagen and glycosaminoglycans.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001132_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001132_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dense collagenous homogenization of the dermis and subcutaneous fat, loss of skin appendages, and progressive cutaneous sclerosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001133_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001133_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of B lymphocytes generates high titers of pathogenic IgM autoantibodies directed against the ganglioside GM1.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001133_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001133_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Anti-GM1 IgM autoantibodies bind specifically to GM1 enriched at the nodes of Ranvier and paranodal regions of motor axons.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001133_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001133_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibody binding activates the classical complement cascade, depositing C3b and terminal membrane attack complexes (C5b-9).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001133_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001133_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Disruption of nodal sodium channel (Nav) clusters, inactivation of potassium channels, and impairment of paranodal axoglial junctions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001133_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001133_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Focal motor nerve conduction block, progressive demyelination, and secondary motor axonal loss produce asymmetric, purely motor limb weakness without sensory loss.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001134_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001134_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (RNF213 p.R4810K founder variant) coupled with autoimmune/inflammatory triggers (elevated thyroid antibodies, IgG4).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001134_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001134_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pro-inflammatory cytokines and endothelial shear stress recruit T cells and macrophages to the terminal internal carotid arteries.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001134_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001134_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic intimal fibrocellular hyperplasia, smooth muscle cell migration, and internal elastic lamina fragmentation without overt atherosclerosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001134_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001134_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive, bilateral luminal stenosis and occlusion of the terminal internal carotid arteries and circle of Willis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001134_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001134_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Compensatory development of an abnormal, fragile network of basal collateral microvessels (&quot;puff of smoke&quot;), risking ischemic strokes and intracranial hemorrhages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001135_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001135_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-DRB1*15:01) and environmental triggers (EBV infection, vitamin D deficiency, smoking) activate autoreactive CD4+ T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001135_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001135_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive Th1 (IFN-γ) and Th17 (IL-17) cells and B cells breach the blood-brain barrier via upregulated integrins (VLA-4).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001135_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001135_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Reactivation within the CNS by local antigen-presenting cells triggers microglial activation, astrogliosis, and recruitment of cytotoxic CD8+ T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001135_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001135_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Effector cells, intrathecal oligoclonal antibodies, and complement destroy myelin sheaths and oligodendrocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001135_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001135_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Focal inflammatory demyelination and progressive neuroaxonal transection across the central nervous system produce relapsing or progressive neurological deficits.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001136_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001136_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Thymic abnormalities (hyperplasia or thymoma) provide the site for loss of tolerance against the muscle nicotinic acetylcholine receptor (AChR).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001136_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001136_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ T helper cells stimulate B cells and plasma cells to synthesize high-affinity IgG (predominantly IgG1 and IgG3) against AChR.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001136_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001136_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating anti-AChR autoantibodies bind the α-subunit of postsynaptic AChRs at the neuromuscular junction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001136_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001136_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies cross-link AChRs, accelerating internalization, and activate the classical complement cascade, depositing C5b-9 membrane attack complexes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001136_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001136_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Destruction of postsynaptic junctional folds and loss of functional AChR density impair action potential generation, causing fatigable skeletal muscle weakness.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001137_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001137_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding infection or autoimmune trigger initiates loss of peripheral tolerance against myelin oligodendrocyte glycoprotein (MOG).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001137_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001137_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B cells synthesize high-affinity, conformational IgG1 autoantibodies targeting the extracellular domain of MOG.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001137_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001137_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating anti-MOG IgG crosses a disrupted blood-brain barrier into the central nervous system parenchyma.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001137_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001137_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind MOG on the outermost lamellae of CNS myelin sheaths and oligodendrocytes, fixing complement (C1q).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001137_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001137_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complement-mediated lysis and macrophage-mediated myelin stripping produce prominent, steroid-responsive optic neuritis, transverse myelitis, and acute demyelinating encephalomyelitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001138_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001138_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Viral cardiotropic infection or systemic autoimmunity causes cardiomyocyte necrosis, exposing sequestered cardiac myosin heavy chain and troponins.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001138_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001138_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Priming of autoreactive CD4+ Th1/Th17 lymphocytes and CD8+ cytotoxic T cells in cardiac draining lymph nodes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001138_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001138_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive infiltration of the myocardial interstitium by lymphocytes and macrophages with secretion of IFN-γ, TNF-α, and IL-1β.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001138_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001138_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Direct cytotoxic T-cell-mediated lysis of cardiomyocytes and autoantibody-mediated membrane damage.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001138_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001138_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extensive cardiomyocyte apoptosis, myocardial interstitial edema, fibrosis, and conduction block lead to heart failure, lethal arrhythmias, or dilated cardiomyopathy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001139_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001139_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-DRB1) and environmental exposures (UV light, statins, viruses) activate innate and adaptive immune cascades.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001139_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001139_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Presentation of muscle autoantigens (synthetases, SRP, Mi-2) primes CD4+ helper and CD8+ cytotoxic T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001139_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001139_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Depending on subtype: endomysial invasion of non-necrotic fibers by CD8+ T cells (polymyositis/sIBM), perifascicular ischemic necrosis via complement (dermatomyositis), or antibody-mediated myofiber necrosis (IMNM).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001139_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001139_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Release of cytotoxic perforin/granzyme, type I interferons, and proinflammatory cytokines damages sarcolemma and myofibrils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001139_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001139_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive myofiber necrosis, muscle atrophy, and replacement by fibroadipose tissue cause profound proximal muscle weakness and elevated muscle enzymes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001140_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001140_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Persistent immune complex deposition or ANCA-induced neutrophil hyperactivation damages vascular endothelial barriers.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001140_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001140_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the muscular walls of small and medium arteries by neutrophils, macrophages, and cytotoxic lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001140_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001140_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Uncontrolled release of reactive oxygen species, matrix metalloproteinases, and lysosomal elastase destroys the internal elastic lamina.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001140_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001140_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extensive transmural fibrinoid necrosis develops throughout all layers of the arterial wall.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001140_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001140_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Vessel thrombosis, downstream tissue ischemia, aneurysmal dilatation, and catastrophic vessel rupture produce severe organ infarction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001141_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001141_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transplacental passive transfer of maternal IgG autoantibodies against Ro/SSA (specifically Ro52) and La/SSB to the developing fetus around weeks 16-24.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001141_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001141_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Maternal anti-Ro52 antibodies bind to apoptotic fetal cardiocytes and surface L-type calcium channels (Cav1.2) in the fetal atrioventricular (AV) node.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001141_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001141_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inhibition of L-type calcium currents disrupts electrical conduction and promotes cardiocyte apoptosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001141_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001141_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cross-linking of surface-translocated Ro antigens recruits fetal macrophages, triggering robust secretion of TGF-β.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001141_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001141_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Irreversible transdifferentiation of AV nodal tissue into non-conductive fibrous scar tissue causes complete, permanent congenital third-degree heart block.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001142_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001142_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding immune stimulus (viral infection, vaccination, surgery, pregnancy) or SEPT9 genetic variant triggers brachial plexus autoimmunity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001142_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001142_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Aberrant activation of autoreactive T lymphocytes and circulating antibodies directed against brachial plexus peripheral nerves.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001142_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001142_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of brachial plexus epineurium and perineurium by inflammatory mononuclear cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001142_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001142_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe focal epineurial perivascular inflammation, microvascular ischemia, and multifocal inflammatory edema.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001142_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001142_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Hourglass constrictions, focal fascicular demyelination, and motor axonal degeneration produce sudden, excruciating shoulder pain followed by patchy paresis and muscle wasting.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001143_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001143_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of tolerance in HLA-DRB1*03:01 individuals leads to production of pathogenic IgG1 autoantibodies against aquaporin-4 (AQP4).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001143_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001143_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating anti-AQP4 IgG breaches the blood-brain barrier and binds AQP4 water channels densely clustered on astrocytic end-feet.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001143_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001143_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Classical complement activation triggers extensive C5b-9 membrane attack complex assembly on astrocytic membranes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001143_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001143_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complement-mediated astrocytic lysis, massive granulocytic/eosinophilic infiltration, and release of astrocytic glutamate.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001143_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001143_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Secondary bystander demyelination, oligodendrocyte necrosis, and axonal transection cause severe, longitudinally extensive transverse myelitis and bilateral optic neuritis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001144_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001144_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Underlying neoplasm (thymoma, lung cancer) or idiopathic autoimmunity breaks tolerance against peripheral nerve voltage-gated potassium channels.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001144_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001144_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of pathogenic IgG autoantibodies targeting contactin-associated protein-like 2 (CASPR2) or VGKC complexes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001144_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001144_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind juxtaparanodal regions of terminal motor axons, accelerating potassium channel internalization and degradation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001144_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001144_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Marked reduction in Kv1.1 and Kv1.2 channel density prevents normal axonal repolarization after action potential propagation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001144_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001144_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Axonal hyperexcitability and continuous spontaneous motor nerve discharges cause progressive muscle stiffness, continuous twitching (myokymia/fasciculations), and cramps.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001146_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001146_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ T cells recognize shared autoantigens, predominantly TSH receptor (TSHR) and IGF-1R, on orbital fibroblasts.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001146_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001146_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of orbital adipose tissue and extraocular perimysium by CD4+ T cells and macrophages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001146_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001146_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Secretion of IFN-γ, IL-1β, and TNF-α stimulates CD34+ orbital fibroblasts to produce immense quantities of hydrophilic glycosaminoglycans (hyaluronic acid).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001146_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001146_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive fluid accumulation, edema, and adipogenesis cause marked swelling of extraocular muscles and retrobulbar fat.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001146_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001146_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Intraconal pressure elevation, mechanical restriction of extraocular muscle excursion, proptosis, and compressive optic neuropathy result in severe diplopia and visual loss.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001147_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001147_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Neuroblastoma in young children (paraneoplastic) or post-viral/idiopathic immune dysregulation in adults activates humoral and cellular immunity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001147_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001147_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of antineuronal autoantibodies alongside activation of CD4+ T cells and clonal B cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001147_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001147_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breaching of the blood-brain barrier by immune effectors into the brainstem and cerebellar vermis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001147_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001147_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoimmune disinhibition of the fastigial nucleus of the cerebellum and omnipause neurons within the pontine reticular formation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001147_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001147_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unchecked saccadic burst generator excitation produces chaotic, conjugate saccadic eye movements (&quot;dancing eyes&quot;), generalized myoclonus (&quot;dancing feet&quot;), and ataxia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001148_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001148_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (HLA-DRB1 shared epitope) and environmental factors prime citrulline- and rheumatoid factor-reactive B cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001148_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001148_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transient generation of high-affinity anti-cyclic citrullinated peptide (anti-CCP) antibodies and rheumatoid factor (RF).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001148_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001148_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Episodic microvascular immune-complex deposition in periarticular tissues and synovial sheaths.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001148_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001148_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Sudden, brief recruitment of neutrophils and mast cell activation releasing inflammatory mediators.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001148_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001148_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Abrupt onset of severe, painful monoarticular or periarticular swelling that resolves completely within hours to days without radiographic joint erosions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001149_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001149_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Underlying malignancy (ovarian, breast, or lung carcinoma) aberrantly expresses onconeural antigens (Yo/CDR2, Hu, Tr).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001149_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001149_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>The immune system mounts a potent anti-tumor immune response, priming autoreactive CD8+ cytotoxic T cells and generating onconeural antibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001149_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001149_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Onconeural antigen-specific CD8+ cytotoxic T cells cross the blood-brain barrier and infiltrate the cerebellar cortex.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001149_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001149_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>CD8+ T cells engage cerebellar Purkinje cells displaying onconeural peptides via MHC Class I, releasing perforin and granzymes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001149_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001149_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Irreversible, near-complete apoptotic destruction of cerebellar Purkinje neurons produces subacute, progressive, devastating cerebellar ataxia and dysarthria.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001150_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001150_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Underlying occult or overt neoplasm (Castleman disease, non-Hodgkin lymphoma, CLL) expresses plakin family proteins.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001150_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001150_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cross-reactive humoral and cellular immunity generates autoantibodies against envoplakin, periplakin, desmoplakin, and desmogleins 1 and 3.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001150_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001150_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pathogenic autoantibodies bind mucosal and epidermal cell-cell junctions, disrupting desmosomes and hemidesmosomes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001150_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001150_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Concurrently, autoreactive cytotoxic CD8+ T cells infiltrate the basal layer of stratified and respiratory epithelium.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001150_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001150_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Combined intraepidermal acantholysis and interface lichenoid dermatitis produce intractable mucocutaneous ulcerations and lethal bronchiolitis obliterans.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001151_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001151_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding viral (adenovirus, measles) or bacterial (Treponema pallidum) infection induces transient loss of B-cell tolerance.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001151_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001151_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal synthesis of the Donath-Landsteiner autoantibody: a polyclonal IgG specific for the P blood group globoside antigen.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001151_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001151_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>In cooler peripheral capillaries (&lt;20-30°C), Donath-Landsteiner IgG binds erythrocyte P antigen and fixes early complement components (C1-C4).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001151_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001151_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Upon circulation back to warmer central body temperatures (37°C), IgG detaches while bound complement activates terminal lytic components (C5b-9).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001151_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001151_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Rapid, massive intravascular erythrocyte lysis produces sudden chills, fever, hemoglobinemia, severe anemia, and dark reddish-brown hemoglobinuria.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001152_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001152_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Somatic X-linked loss-of-function mutation in the PIGA gene within a single bone marrow hematopoietic stem cell.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001152_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001152_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Disrupted synthesis of glycosylphosphatidylinositol (GPI) anchors prevents expression of GPI-anchored surface proteins.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001152_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001152_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of hematopoietic cells completely lacking surface complement regulatory proteins CD55 (DAF) and CD59 (MAC-inhibitory protein).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001152_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001152_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Spontaneous, continuous activation of the alternative complement cascade on red blood cell membranes during baseline physiological tick-over.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001152_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001152_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unopposed assembly of C5b-9 membrane attack complexes drives chronic intravascular hemolysis, platelet activation, severe thrombosis, and bone marrow failure.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001153_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001153_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pharyngeal infection with Group A beta-hemolytic Streptococcus (GABS) induces an adaptive immune response.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001153_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001153_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Molecular mimicry between streptococcal wall carbohydrate/M protein and human basal ganglia antigens (lysoganglioside GM1, tubulin, D1/D2 receptors).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001153_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001153_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cross-reactive autoantibodies breach a compromised blood-brain barrier into the central nervous system.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001153_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001153_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind neuronal surface targets in the caudate nucleus and putamen, activating calcium/calmodulin-dependent protein kinase II (CaMKII).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001153_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001153_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dopaminergic neuronal signaling upregulation and striatal network dysfunction produce acute, dramatic onset of obsessive-compulsive disorder (OCD) and tics.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001154_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001154_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-DRB1*04:02 / DQB1*05:03) drives loss of tolerance against epidermal desmosomal cadherins.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001154_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001154_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ Th2 cells stimulate B cells to produce pathogenic IgG autoantibodies (IgG4 and IgG1) against desmoglein 3 (PV) and/or desmoglein 1 (PV and PF).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001154_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001154_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind extracellular cadherin-like domains of desmoglein molecules on epidermal and mucosal keratinocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001154_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001154_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Steric hindrance of desmosomal adhesion and antibody-induced intracellular signaling (p38 MAPK) cause desmosome internalization and cleavage.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001154_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001154_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of cell-cell cohesion (acantholysis) creates intraepithelial suprabasal (PV) or subcorneal (PF) clefting, forming flaccid blisters and painful erosions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001155_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001155_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal plasma cell neoplasm (typically producing restricted monoclonal IgA-lambda or IgG-lambda light chains) colonizes bone marrow or plasmacytoma.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001155_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001155_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal cells and microenvironmental stromal cells produce massive quantities of vascular endothelial growth factor (VEGF), IL-6, and IL-1β.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001155_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001155_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Markedly elevated circulating VEGF induces widespread microvascular hyperpermeability and endoneurial neoangiogenesis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001155_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001155_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of the blood-nerve barrier causes endoneurial edema, ischemia, uncoupling of Schwann cell function, and demyelination with axonal loss.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001155_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001155_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Multiorgan features develop: Polyneuropathy, Organomegaly, Endocrinopathy, Monoclonal protein, and Skin changes with extravascular fluid overload.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001156_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001156_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Idiopathic autoimmunity or Hepatitis B virus (HBV) surface antigen-antibody immune complex formation in genetically predisposed individuals.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001156_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001156_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deposition of immune complexes or primary inflammatory targeting of the walls of medium-sized muscular arteries.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001156_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001156_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transmural infiltration of the arterial wall by polymorphonuclear neutrophils, followed by macrophages and lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001156_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001156_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extensive transmural fibrinoid necrosis and disruption of the internal and external elastic laminae.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001156_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001156_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Weakening of arterial walls produces aneurysmal dilatations (&quot;string of beads&quot;), luminal thrombosis, and ischemic infarction of kidneys, bowel, nerves, and skin.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001157_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001157_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autosomal recessive loss-of-function mutations in the autoimmune regulator (AIRE) gene located on chromosome 21q22.3.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001157_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001157_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Failure of AIRE-dependent ectopic expression of tissue-specific self-antigens in medullary thymic epithelial cells (mTECs).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001157_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001157_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Defective negative selection allows massive escape of high-affinity self-reactive CD4+ and CD8+ T cell clones into peripheral circulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001157_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001157_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of autoantibodies against cytokines (IL-17A, IL-17F, IL-22, IFN-ω) and organ antigens (CYP21A2, CaSR, NALP5).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001157_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001157_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Classic triad of chronic mucocutaneous candidiasis (via IL-17 neutralization), primary hypoparathyroidism, and primary adrenal insufficiency.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001158_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001158_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Polygenic susceptibility linked to HLA-DR3 (DRB1*03:01) and HLA-DR4 (DRB1*04:01) alongside CTLA4 and PTPN22 risk variants.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001158_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001158_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive, multi-organ loss of self-tolerance to shared and organ-specific endocrine autoantigens (CYP21A2, TPO, GAD65).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001158_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001158_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activation of autoreactive CD4+ Th1 lymphocytes and generation of organ-specific autoantibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001158_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001158_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cell-mediated cytotoxic T-lymphocytic infiltration of the adrenal cortex, thyroid gland, and pancreatic islets.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001158_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001158_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Concomitant or sequential immune destruction produces primary adrenal insufficiency (Addison&apos;s), autoimmune thyroid disease, and type 1 diabetes mellitus.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001159_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001159_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Polygenic autoimmune predisposition (HLA-DR3, HLA-DR4, HLA-DQ8) without adrenal involvement.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001159_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001159_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of self-tolerance against thyroidal antigens (TPO, Tg) combined with islet beta-cell antigens (GAD65, IA-2) or gastric parietal cell antigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001159_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001159_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Expansion of autoreactive CD4+ Th1/Th17 cells and B-cell production of high-titer autoantibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001159_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001159_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic lymphocytic infiltration and apoptotic destruction of thyroid follicular cells and endocrine tissues.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001159_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001159_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clinical coexistence of autoimmune thyroid disease (Hashimoto&apos;s or Graves&apos;) with type 1 diabetes mellitus, pernicious anemia, vitiligo, or alopecia areata.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001160_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001160_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Polygenic immune dysregulation impairs peripheral tolerance against multiple endocrine and non-endocrine tissue autoantigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001160_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001160_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Presentation of tissue-specific antigens prompts clonal expansion of autoreactive CD4+ T helper cells and B cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001160_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001160_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Generation of diverse organ-specific autoantibodies (anti-TPO, anti-parietal cell, anti-intrinsic factor, anti-gonadal).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001160_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001160_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic lymphocytic infiltration and cytokine-mediated apoptosis of affected target tissues.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001160_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001160_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clinical coexistence of autoimmune endocrinopathies and organ-specific diseases failing to meet classic criteria for APS-1, 2, or 3 (e.g., hypoparathyroidism with atrophic gastritis or vitiligo).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001161_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001161_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Aging and genetic predisposition (HLA-DRB1*04) prime innate toll-like receptors (TLR4, TLR7) on circulating monocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001161_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001161_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of systemic IL-6 and IL-1β drives profound hepatic acute-phase response (elevated ESR, CRP).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001161_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001161_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Recruitment of CD4+ Th1 and Th17 lymphocytes into periarticular synovial structures (shoulder, hip bursae, and tenosynovial sheaths).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001161_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001161_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transmural macrophage infiltration and synovial fluid exudation without bone erosions or pannus formation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001161_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001161_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Marked bilateral subacromial/subdeltoid bursitis, trochanteric bursitis, and biceps tenosynovitis produce severe morning stiffness and pelvic/shoulder girdle aching.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001162_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001162_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-DRB1*03:01) leads to aberrant presentation of skeletal muscle autoantigens via MHC Class I on the sarcolemma.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001162_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001162_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of antigen-driven, autoreactive CD8+ cytotoxic T lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001162_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001162_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>CD8+ T cells and macrophages directly infiltrate the muscle endomysium, surrounding and invading non-necrotic muscle fibers.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001162_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001162_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Perforin/granzyme exocytosis across the immunological synapse punches pores into the sarcolemma, inducing myofiber apoptosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001162_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001162_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extensive muscle fiber necrosis, regeneration failure, and endomysial fibrosis lead to symmetrical proximal muscle weakness and elevated creatine kinase.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001163_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001163_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transmural myocardial necrosis during acute myocardial infarction releases sequestered cardiac antigens and exposes pericardial mesothelium.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001163_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001163_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Presentation of novel cardiac autoantigens to naive lymphocytes breaks tolerance in pericardial draining lymph nodes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001163_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001163_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of anti-myocardial autoantibodies (anti-actin, anti-myosin) and formation of circulating immune complexes 2-10 weeks post-infarction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001163_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001163_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immune complexes deposit in the pericardial and pleural membranes, activating complement.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001163_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001163_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Exudative fibrinous inflammation of the visceral and parietal pericardium produces chest pain, pericardial friction rub, fever, and effusion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001164_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001164_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Post-viral immune priming or immune dysregulation generates functional autoantibodies targeting G-protein-coupled receptors (GPCRs).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001164_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001164_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies selectively bind and functionally activate or block α1-adrenergic, β1/β2-adrenergic, and M2/M4 muscarinic receptors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001164_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001164_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Impaired α1-mediated peripheral vasoconstriction causes persistent venous blood pooling in the splanchnic and lower limb circulation upon standing.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001164_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001164_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Secondary excessive compensatory sympathetic outflow and β1-receptor stimulation trigger pronounced sinus tachycardia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001164_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001164_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inadequate cerebral perfusion and autonomic hyperadrenergic state cause orthostatic intolerance, lightheadedness, brain fog, and palpitation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001165_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001165_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of peripheral tolerance prompts B-cell differentiation and production of autoantibodies against GPIHBP1.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001165_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001165_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>High-titer IgG autoantibodies bind the lymphocyte antigen 6 domain of glycosylphosphatidylinositol-anchored high-density lipoprotein-binding protein 1 (GPIHBP1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001165_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001165_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies block the ability of GPIHBP1 to capture lipoprotein lipase (LPL) and transport it across capillary endothelial cells into the vascular lumen.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001165_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001165_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Absence of functional luminal LPL halts intravascular lipolysis and hydrolysis of circulating chylomicrons.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001165_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001165_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive intravascular accumulation of triglyceride-rich chylomicrons results in severe hyperchylomicronemia, eruptive xanthomas, and recurrent acute pancreatitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001166_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001166_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (HLA-DRB1*08, IL12A) and environmental xenobiotic exposure break tolerance to the E2 subunit of pyruvate dehydrogenase (PDC-E2).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001166_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001166_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>PDC-E2 remains immunologically intact within apoptotic blebs (apotopes) of small intrahepatic biliary epithelial cells (cholangiocytes).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001166_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001166_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of PDC-E2-specific CD4+ Th1/Th17 cells, antimitochondrial antibodies (AMA), and cytotoxic CD8+ T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001166_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001166_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic lymphocytic infiltration of portal tracts with direct cytotoxicity against small interlobular and septal bile ducts (&quot;florid duct lesions&quot;).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001166_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001166_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive ductopenia, chronic intrahepatic cholestasis, portal inflammation, and progressive biliary cirrhosis lead to liver failure.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001167_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001167_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility coupled with prior viral myocarditis exposes cryptic cardiomyocyte antigens (β1-adrenergic receptor, cardiac myosin, troponin I).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001167_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001167_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of functionally stimulatory autoantibodies targeting the second extracellular loop of the β1-adrenergic receptor.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001167_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001167_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Persistent autoantibody-mediated agonist stimulation causes chronic intracellular cAMP elevation, protein kinase A activation, and cytosolic calcium overload.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001167_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001167_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cardiomyocyte apoptosis, defective excitation-contraction coupling, and secondary reactive myocardial fibrosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001167_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001167_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive four-chamber dilatation, eccentric ventricular remodeling, impaired systolic contractility, and congestive heart failure.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001169_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001169_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Gut dysbiosis, bacterial translocation via the portal vein, and genetic risk (HLA-B*08, HLA-DRB1*03:01) initiate biliary periductal inflammation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001169_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001169_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Recruitment of gut-primed homing T lymphocytes (expressing α4β7 and CCR9) to the liver via aberrantly expressed MAdCAM-1 and CCL25.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001169_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001169_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of large and medium intra- and extrahepatic bile ducts by CD4+ and CD8+ T cells and macrophages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001169_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001169_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activation of periductal myofibroblasts drives concentric &quot;onion-skin&quot; periductal fibrosis and obliterative cholangitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001169_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001169_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Multifocal strictures and segmental dilatations of the biliary tree cause chronic cholestasis, recurrent bacterial cholangitis, and secondary biliary cirrhosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001170_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001170_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Postulated localized autoimmune neurovasculitis of the cervical sympathetic chain or trigeminal nerve distribution.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001170_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001170_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Perivascular lymphocytic and plasma cell infiltration within subcutaneous adipose tissue and dermis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001170_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001170_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive microvascular ischemia and localized tissue destruction driven by oligoclonal T cells and antinuclear autoantibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001170_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001170_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe atrophy and disappearance of subcutaneous fat lobules, facial muscle fibers, and underlying cartilage and bone.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001170_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001170_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Hemifacial soft tissue depression, cutaneous hyperpigmentation, &quot;en coup de sabre&quot; furrowing, and ocular and dental alterations.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001171_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001171_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Trauma, infection (Streptococcus), or stress causes keratinocytes to release antimicrobial peptide LL-37 (cathelicidin) and self-DNA/RNA.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001171_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001171_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Plasmacytoid dendritic cells sense LL-37-nucleic acid complexes via TLR7/9, secreting abundant IFN-α to activate myeloid dendritic cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001171_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001171_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Myeloid dendritic cells migrate to draining lymph nodes and secrete IL-23 and IL-12, driving CD4+ Th17 and CD8+ Tc17 cell expansion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001171_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001171_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Effector T cells home to the epidermis, secreting IL-17A, IL-17F, and IL-22.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001171_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001171_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive keratinocyte hyperproliferation, parakeratosis, Munro microabscesses, and dilated dermal capillary loops form erythematous, silvery-scaled plaques.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001172_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001172_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Biomechanical entheseal stress or cutaneous cytokine spillover in HLA-B*27/B*38-positive patients triggers innate immune sensing.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001172_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001172_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Local activation of entheseal tissue-resident cells and myeloid cells, secreting IL-23.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001172_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001172_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Proliferation of IL-23R-positive Th17 cells, γδ T cells, and ILC3s, producing large quantities of IL-17A, IL-22, and TNF-α.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001172_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001172_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synovio-entheseal complex inflammation with simultaneous osteoclast-mediated bone erosions and IL-22-driven periosteal new bone formation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001172_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001172_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dactylitis, enthesitis, axial spondylitis, peripheral asymmetric oligo/polyarthritis, and joint destruction (&quot;pencil-in-cup&quot; deformity).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001173_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001173_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal T-cell expansion (frequently associated with thymoma, T-LGL leukemia, or drugs) or anti-erythropoietin autoantibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001173_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001173_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal CD8+ cytotoxic T cells or autoantibodies specifically target bone marrow erythroid progenitor cells (CFU-E and BFU-E).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001173_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001173_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Effector CD8+ T cells induce Fas-mediated or perforin/granzyme-dependent apoptosis of erythroid precursors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001173_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001173_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complete arrest and virtual absence of erythroid lineage precursors in the bone marrow, with normal myeloid and megakaryocytic lineages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001173_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001173_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Profound reticulocytopenia and severe normocytic normochromic anemia requiring chronic blood transfusions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001174_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001174_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (mutations in autoinflammatory genes: PSTPIP1) or associated systemic diseases (IBD, RA, hematologic malignancy) prime innate immunity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001174_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001174_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Hyperactivation of the inflammasome and aberrant overproduction of IL-1β, IL-8 (CXCL8), IL-17, and TNF-α.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001174_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001174_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive, uncontrolled chemotaxis and tissue infiltration of mature polymorphonuclear neutrophils into the dermis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001174_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001174_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Neutrophilic degranulation and release of elastase, matrix metalloproteinases, and reactive oxygen species without true primary vasculitis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001174_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001174_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Rapid necrotizing destruction of the epidermis and dermis, forming painful, violaceous, undermined-bordered expanding cutaneous ulcers with pathergy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001175_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001175_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Idiopathic or viral trigger stimulates an aberrant, unilateral central nervous system immune response.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001175_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001175_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of cytotoxic CD8+ T lymphocytes directed against neuronal and astroglial antigens (such as GluR3).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001175_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001175_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Perivascular cuffing and parenchymal infiltration of one cerebral hemisphere by CD8+ T cells and activated microglia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001175_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001175_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>CD8+ T-cell perforin- and granzyme-mediated apoptosis of cortical pyramidal neurons and surrounding astrocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001175_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001175_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive, unilateral hemispheric cortical atrophy producing intractable epilepsia partialis continua, progressive hemiparesis, and cognitive decline.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001176_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001176_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Endothelial damage from circulating autoantibodies (e.g., Scl-70, ACA) or immune complexes in connective tissue disease.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001176_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001176_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Diminished endothelial production of vasodilators (prostacyclin, nitric oxide) and elevated secretion of vasoconstrictor endothelin-1.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001176_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001176_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cold exposure or emotional stress triggers excessive α2-adrenergic receptor-mediated sympathetic vasospasm of digital arteries.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001176_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001176_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transient complete cessation of digital microvascular blood flow (ischemic pallor/white phase), followed by capillary cyanosis (blue phase).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001176_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001176_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Reactive reperfusion and vasodilation (hyperemic red phase) cause intense burning pain, paresthesias, and risk of digital ulcerations.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001177_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001177_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding mucosal gastrointestinal (Salmonella, Shigella, Yersinia, Campylobacter) or genitourinary (Chlamydia trachomatis) infection.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001177_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001177_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Microbial antigens disseminate hematogenously within monocytes to synovial joints in genetically susceptible HLA-B*27 individuals.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001177_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001177_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Arthritogenic bacterial peptides presented by HLA-B27 stimulate CD8+ cytotoxic T cells and CD4+ Th17 cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001177_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001177_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Persistent, non-culturable bacterial antigens trigger chronic synovial inflammation and neutrophil recruitment.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001177_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001177_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Asymmetric oligoarthritis (predominantly lower extremities), enthesitis, dactylitis, and extra-articular manifestations (uveitis, urethritis, circinate balanitis).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001178_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001178_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of self-tolerance in individuals with HLA-DR4 against cartilaginous extracellular matrix components (type II, IX, XI collagen, matrilin-1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001178_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001178_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion of CD4+ Th1 lymphocytes and production of anti-type II collagen antibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001178_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001178_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating autoantibodies and immune complexes deposit within avascular cartilage of ears, nose, larynx, trachea, and joints.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001178_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001178_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complement activation and recruitment of neutrophils, macrophages, and CD4+ T cells into the perichondrium.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001178_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001178_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Proteolytic cleavage of proteoglycans and chondrocyte apoptosis produce loss of structural cartilage integrity, saddle nose deformity, and airway collapse.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001179_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001179_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk variants (BTBD9, MEIS1) and peripheral/central iron deficiency impair brain dopaminergic neurotransmission.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001179_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001179_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic peripheral inflammation and elevated pro-inflammatory cytokines (IL-6, TNF-α) compromise endothelial blood-brain barrier function.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001179_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001179_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immune-mediated iron transport dysregulation via altered transferrin receptor signaling in the substantia nigra.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001179_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001179_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Intracellular dopaminergic neuron hypofunction and central spinal cord sensorimotor disinhibition.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001179_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001179_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Irresistible urge to move the legs accompanied by uncomfortable, rest-induced dysesthesias that worsen at night and are relieved by movement.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001180_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001180_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unknown trigger induces an autoimmune attack selectively against the microvasculature of the brain, retina, and inner ear.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001180_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001180_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal cytotoxic CD8+ T lymphocytes and anti-endothelial cell antibodies (AECA) target precapillary arteriolar endothelial cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001180_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001180_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>CD8+ T cells adhere to endothelial cells, inducing perforin-mediated endothelial cell apoptosis and swelling.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001180_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001180_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Microvascular endothelial necrosis triggers microthrombosis and luminal occlusion of microarterioles (&lt;100 µm).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001180_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001180_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clinical triad of multifocal branch retinal artery occlusions (BRAO), low-frequency sensorineural hearing loss, and encephalopathy with central corpus callosum &quot;snowball&quot; lesions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001181_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001181_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pharyngeal infection with Streptococcus pyogenes (Group A beta-hemolytic Streptococcus) mounts an adaptive immune response.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001181_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001181_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Molecular mimicry: Antibodies against streptococcal group A carbohydrate cross-react with neuronal lysoganglioside GM1 and tubulin.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001181_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001181_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pathogenic autoantibodies penetrate the blood-brain barrier and bind dopamine D1 and D2 receptors in the striatum (caudate and putamen).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001181_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001181_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibody binding induces intracellular CaMKII activation, altering tyrosine hydroxylase activity and increasing dopamine release.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001181_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001181_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Striatal network dysfunction causes rapid, involuntary, uncoordinated jerking movements (chorea), muscular hypotonia, and emotional lability.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001182_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001182_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Untreated pharyngeal infection with Group A Streptococcus (GAS) stimulates high-titer antibodies and T-cell responses against streptococcal M protein.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001182_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001182_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Molecular mimicry: M protein epitopes cross-react with human cardiac myosin, tropomyosin, laminin, and valvular endothelium.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001182_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001182_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cross-reactive CD4+ T cells and antibodies infiltrate the heart, binding valvular endothelial cells and upregulating VCAM-1.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001182_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001182_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extravasation of T cells and macrophages into the myocardium and endocardium forms pathognomonic granulomatous Aschoff bodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001182_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001182_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive pan-carditis, valvular verrucae, leaflet scarring, chordae tendineae retraction, and mitral/aortic regurgitation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001184_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001184_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Environmental exposure (smoking, periodontitis) in HLA-DRB1 shared epitope hosts triggers mucosal peptidylarginine deiminase (PAD) citrullination.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001184_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001184_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breach of immune tolerance generates anti-citrullinated protein antibodies (ACPA / anti-CCP) and rheumatoid factor (RF).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001184_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001184_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Migration of autoreactive CD4+ Th1/Th17 cells, B cells, and macrophages into the joint synovium.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001184_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001184_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synovial inflammation and cytokine release (TNF-α, IL-6, IL-1) induce massive synoviocyte proliferation, forming invasive pannus tissue.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001184_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001184_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pannus-derived matrix metalloproteinases (MMPs) and RANKL-mediated osteoclast activation destroy articular cartilage and subchondral bone, causing joint deformity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001185_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001185_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Longstanding, severe seropositive rheumatoid arthritis with high titers of RF and ACPA and circulating immune complexes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001185_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001185_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deposition of large IgG-RF and IgM-RF immune complexes within the walls of small and medium muscular arteries.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001185_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001185_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Classical complement activation (C3a, C5a) recruits and activates neutrophils and monocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001185_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001185_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transmural necrotizing inflammation, neutrophil leukocytoclasia, and elastase-mediated internal elastic lamina destruction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001185_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001185_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Luminal thrombosis, vascular occlusion, and vessel ischemia lead to deep cutaneous ulcerations, digital gangrene, and mononeuritis multiplex.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001186_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001186_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inhalation of poorly degradable airborne or microbial antigens in genetically susceptible hosts (HLA-DRB1*11/15).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001186_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001186_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Alveolar macrophages and dendritic cells present antigen, releasing IL-12 and IL-18 to prime naive T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001186_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001186_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive polarization and oligoclonal expansion of CD4+ Th1 and Th17.1 lymphocytes releasing IFN-γ, TNF-α, and IL-2.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001186_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001186_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Continuous macrophage recruitment, differentiation into epithelioid cells, and fusion into Langhans multinucleated giant cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001186_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001186_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Formation of compact, non-caseating granulomas with peripheral rimming of CD8+ T cells and fibroblasts, causing bilateral hilar lymphadenopathy and pulmonary fibrosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001187_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001187_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Acquired somatic mosaicism in the NLRP3 gene within myeloid lineages or monoclonal gammopathy-driven innate activation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001187_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001187_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal synthesis of a monoclonal IgM (or rarely IgG) paraprotein, typically with kappa light chain.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001187_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001187_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Overactivation of the NLRP3 inflammasome leads to constitutive, massive secretion of active interleukin-1β (IL-1β).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001187_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001187_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Systemic IL-1β drives intense neutrophil recruitment into the dermis and bone remodeling compartments.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001187_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001187_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic urticarial neutrophilic dermatosis, recurrent periodic fevers, arthralgias, severe bone pain, and osteosclerosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001188_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001188_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Association with underlying systemic autoimmune diseases (RA, granulomatosis with polyangiitis, relapsing polychondritis) or idiopathic triggers.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001188_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001188_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the scleral stroma by autoreactive CD4+ Th1/Th17 lymphocytes, macrophages, and neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001188_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001188_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Local immune complex deposition and release of pro-inflammatory cytokines (TNF-α, IL-1β) upregulate collagenases and matrix metalloproteinases.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001188_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001188_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Enzymatic degradation of dense scleral collagen lamellae and deep episcleral vascular occlusion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001188_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001188_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe, boring eye pain, scleral thinning, violaceous injection, risk of scleral perforation (scleromalacia perforans), and vision-threatening complications.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001189_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001189_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Viral infection (EBV, retrovirus) or cellular stress in genetically susceptible individuals (HLA-DR3, IRF5, STAT4) triggers salivary/lacrimal epithelial cell damage.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001189_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001189_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Damaged ductal epithelial cells aberrantly express MHC Class II, produce type I IFNs, and release Ro/SSA and La/SSB autoantigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001189_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001189_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>B-cell activating factor (BAFF) hyperstimulation promotes germinal center-like structures and plasma cell secretion of anti-Ro/SSA, anti-La/SSB, and RF.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001189_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001189_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Focal periductal infiltration of CD4+ T cells, plasmacytoid dendritic cells, and B cells (focus score ≥1 per 4 mm²).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001189_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001189_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cytokine- and granzyme-mediated apoptosis of acinar epithelial cells causes progressive secretory glandular hypofunction (xerostomia, keratoconjunctivitis sicca).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001190_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001190_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Systemic lupus erythematosus disease activity promotes generation of pathogenic autoantibodies targeting dsDNA, nucleosomes, and C1q.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001190_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001190_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Formation of circulating immune complexes and in situ binding of autoantibodies to chromatin fragments planted in the glomerular basement membrane (GBM).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001190_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001190_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immune complexes deposit in mesangial, subendothelial, or subepithelial compartments (Classes I-VI).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001190_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001190_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Potent classical complement cascade activation (C1q, C3, C4) and recruitment of neutrophils and monocytes via Fcγ receptors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001190_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001190_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Endothelial swelling, endocapillary proliferation, crescent formation, wire-loop lesions, podocyte effacement, and proteinuria leading to renal failure.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001191_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001191_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Environmental insult or systemic autoimmunity breaks tolerance against unmyelinated nerve antigens (TS-HDS, FGFR3, plexin D1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001191_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001191_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of pathogenic autoantibodies alongside activation of proinflammatory cytokines (IL-2, TNF-α).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001191_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001191_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies and inflammatory mediators penetrate the permeable microvasculature of dorsal root ganglia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001191_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001191_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complement activation, microvascular endoneurial ischemia, or direct cytotoxicity targeting unmyelinated C-fibers and thinly myelinated A-delta fibers.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001191_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001191_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive somatic and autonomic distal axonal degeneration causes neuropathic pain, burning paresthesias, and autonomic dysfunction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001192_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001192_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoimmune thyroiditis triggers an autoimmune reaction directed against central nervous system vascular and neural antigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001192_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001192_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal synthesis of autoantibodies against the amino-terminal of alpha-enolase (anti-NAE) and thyroid peroxidase (anti-TPO).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001192_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001192_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Anti-NAE and other autoantibodies bind antigens expressed on cerebral microvascular endothelial cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001192_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001192_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immune-mediated cerebral microvasculitis, localized microvascular hypoperfusion, and perivascular lymphocytic cuffing.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001192_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001192_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Diffuse cerebral ischemia and neuroinflammation produce acute or relapsing encephalopathy, stroke-like episodes, myoclonus, cognitive decline, and dramatic steroid responsiveness.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001193_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001193_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of self-tolerance in individuals with HLA-DRB1*03:01 against GABAergic neurotransmission machinery.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001193_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001193_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B cells produce exceptionally high-titer autoantibodies against glutamic acid decarboxylase 65 (GAD65), amphiphysin, or gephyrin.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001193_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001193_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies enter the CNS or are synthesized intrathecally, binding GABAergic interneurons in the spinal cord and motor cortex.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001193_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001193_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inhibition of GAD65 blocks the enzymatic conversion of glutamate to gamma-aminobutyric acid (GABA), severely reducing GABAergic inhibitory tone.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001193_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001193_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unchecked, continuous firing of spinal motor neurons causes progressive axial and limb muscle rigidity, painful spasms, and heightened startle reflex.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001194_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001194_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Low-virulence bacterial colonization (Streptococcus viridans, Enterococcus) of damaged cardiac endothelium forms an infected vegetation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001194_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001194_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Continuous, prolonged bacteremia releases bacterial antigens into the systemic bloodstream for weeks to months.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001194_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001194_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Persistent antigenemia stimulates high-titer antibody synthesis, resulting in large, chronic circulating immune complex (CIC) formation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001194_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001194_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>CICs deposit in microvascular beds, activating classical complement and recruiting neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001194_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001194_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Extracardiac immune manifestations develop: Roth spots, Osler nodes, splinter hemorrhages, and focal immune-complex proliferative glomerulonephritis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001195_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001195_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Penetrating ocular trauma or surgical perforation of one eye (the exciting eye) disrupts anatomical ocular immune privilege.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001195_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001195_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Sequestration failure releases previously hidden uveal tract and retinal autoantigens (retinal S-antigen, IRBP) into ocular draining lymphatics.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001195_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001195_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Presentation by dendritic cells primes CD4+ Th1 and Th17 lymphocytes in regional cervical lymph nodes in HLA-DR4/DQw3 hosts.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001195_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001195_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activated autoreactive T cells migrate and cross the blood-ocular barrier into the contralateral uninjured eye (the sympathizing eye).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001195_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001195_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Bilateral diffuse granulomatous panuveitis with Dalen-Fuchs nodules in the retinal pigment epithelium leads to devastating bilateral vision loss.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001196_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001196_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (HLA-DR2/DR3, complement deficiencies) and environmental triggers (UV light, viral infection) induce apoptosis and defective clearance of apoptotic material.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001196_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001196_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Accumulation of secondary necrotic cell debris exposes nuclear antigens (dsDNA, Sm, histones, Ro, La) to dendritic cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001196_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001196_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Plasmacytoid dendritic cells produce high levels of type I interferon (IFN-α), promoting B-cell hyperactivation and autoantibody production.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001196_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001196_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Pathogenic autoantibodies form circulating and in situ immune complexes that deposit in skin, kidneys, joints, vessels, and serosa.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001196_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001196_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complement activation (C3, C4) and inflammatory cell recruitment cause widespread multi-organ tissue damage (nephritis, malar rash, arthritis, serositis, cerebritis).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001197_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001197_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Somatic activating gain-of-function mutation in the KIT receptor tyrosine kinase gene (KIT D816V) in hematopoietic progenitor cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001197_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001197_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Constitutive, ligand-independent KIT receptor autophosphorylation drives autonomous proliferation and prolonged survival of mast cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001197_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001197_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal mast cells systematically invade and infiltrate extracutaneous organs (bone marrow, spleen, liver, gastrointestinal tract).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001197_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001197_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Excessive mast cell burden leads to spontaneous and provoked massive systemic degranulation (histamine, tryptase, prostaglandins).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001197_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001197_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe episodic flushing, anaphylaxis, hypotension, osteolytic lesions, hepatosplenomegaly, and malabsorption develop.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001198_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001198_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility and environmental triggers (silica, organic solvents) induce persistent microvascular endothelial cell injury.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001198_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001198_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Upregulated endothelial adhesion molecules and release of endothelin-1 cause microvascular obliteration, capillary rarefaction, and tissue hypoxia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001198_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001198_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Immune activation with CD4+ Th2/Th17 lymphocytes and autoantibody production (anti-Scl-70 / topoisomerase I, anti-RNA polymerase III).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001198_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001198_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltrating immune cells and macrophages release pro-fibrotic cytokines, primarily TGF-β, PDGF, and IL-13.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001198_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001198_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Persistent myofibroblast activation and uncontrolled synthesis of collagen and extracellular matrix lead to progressive skin sclerosis and pulmonary/renal fibrosis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001199_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001199_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Microvascular endothelial injury in genetically predisposed individuals induces endothelial apoptosis and defective vascular repair.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001199_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001199_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Influx of inflammatory cells with production of anti-centromere antibodies (ACA / CENP-B).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001199_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001199_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Endothelial-to-mesenchymal transition and concentric intimal hyperplasia cause luminal narrowing of digital and pulmonary microvessels.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001199_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001199_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>TGF-β and connective tissue growth factor (CTGF) stimulate localized dermal fibroblasts to produce excessive extracellular matrix.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001199_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001199_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Manifestation of CREST features: Calcinosis, Raynaud&apos;s phenomenon, Esophageal dysmotility, Sclerodactyly, and Telangiectasia, with late pulmonary arterial hypertension.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001200_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001200_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-B*52) and unknown triggers induce immune activation against aortic and large-vessel vascular antigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001200_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001200_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive γδ T cells, cytotoxic CD8+ T cells, and Th1 lymphocytes infiltrate the adventitia and media of the aorta and its primary branches.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001200_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001200_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Granulomatous panarteritis with release of perforin, granzyme, and pro-inflammatory cytokines (IFN-γ, IL-6, TNF-α).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001200_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001200_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Macrophages and multinucleated giant cells release matrix metalloproteinases, destroying elastic fibers and smooth muscle in the vascular media.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001200_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001200_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Marked adventitial fibrosis, concentric fibrointimal proliferation, luminal stenosis, occlusion, or post-stenotic aneurysms (&quot;pulseless disease&quot;).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001201_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001201_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Aging-related changes in cranial arterial walls and HLA-DRB1*04 alleles prime dendritic cells embedded in the adventitia via toll-like receptors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001201_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001201_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Activated vascular dendritic cells produce chemokines, recruiting CD4+ T helper cells (Th1 producing IFN-γ and Th17 producing IL-17).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001201_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001201_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transmural infiltration of the muscular media by T lymphocytes and macrophages, forming multinucleated giant cells along the internal elastic lamina.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001201_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001201_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Macrophages secrete matrix metalloproteinases (MMP-9) and reactive oxygen species, fragmenting the internal elastic lamina.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001201_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001201_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Platelet-derived growth factor (PDGF) stimulates exuberant intimal hyperplasia, causing luminal occlusion, temporal artery tenderness, and ischemic optic neuropathy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001202_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001202_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Somatic mutations or loss of heterozygosity in the TRIM33 gene within an underlying malignant tumor leads to aberrant TIF1-γ neoantigen expression.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001202_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001202_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>The immune system mounts a vigorous anti-tumor response, generating high-titer IgG autoantibodies and cytotoxic T cells against TIF1-γ (TRIM33).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001202_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001202_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Shared expression of TIF1-γ in regenerating muscle fibers and basal keratinocytes triggers cross-reactive autoimmunity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001202_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001202_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Deposition of complement (C5b-9) and type I interferon pathway hyperactivation along perifascicular endomysial capillaries and dermo-epidermal junction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001202_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001202_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe, extensive dermatomyositis rash (flagellate erythema, V-sign) and proximal myopathy tightly linked to adult malignancy.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001203_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001203_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Idiopathic autoimmune or post-viral inflammatory trigger localized to the cavernous sinus, superior orbital fissure, or orbital apex.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001203_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001203_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the cavernous sinus dura mater and retro-orbital connective tissue by non-caseating granulomatous inflammatory tissue.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001203_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001203_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Accumulation of lymphocytes, plasma cells, and epithelioid histiocytes produces localized inflammatory pseudotumor swelling.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001203_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001203_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Compressive encasement and ischemia of the intracavernous internal carotid artery and cranial nerves III, IV, V1/V2, and VI.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001203_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001203_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe periorbital or retro-orbital pain accompanied by ipsilateral painful ophthalmoplegia and sensory deficits in the ophthalmic division of the trigeminal nerve.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001204_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001204_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Post-infectious, post-vaccinal, or systemic autoimmune trigger activates autoreactive myelin- and axonal-specific T lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001204_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001204_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive CD4+ Th1/Th17 cells and macrophages cross the blood-spinal cord barrier into thoracic or cervical spinal cord segments.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001204_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001204_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Intense focal perivenular lymphocytic infiltration, microglial activation, and secretion of cytotoxic cytokines (IFN-γ, TNF-α).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001204_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001204_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Complement activation and inflammatory edema cause acute focal demyelination, axonal transection, and necrosis across the spinal cord cross-section.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001204_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001204_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Acute bilateral motor weakness, sensory level loss, and autonomic bladder/bowel dysfunction below the level of the spinal lesion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001205_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001205_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-DRB1*01:03, IL23R) and environmental factors compromise the colonic mucosal epithelial and mucus (MUC2) barrier.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001205_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001205_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Luminal commensal bacterial antigens translocate into the colonic lamina propria, activating mucosal dendritic cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001205_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001205_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Aberrant differentiation of atypical CD4+ Th2-like and Th17 cells producing IL-13, IL-5, and IL-9, which directly impair epithelial barrier function.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001205_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001205_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive recruitment of polymorphonuclear neutrophils that infiltrate the crypt epithelium, forming pathognomonic crypt abscesses.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001205_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001205_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Mucosal necrosis, loss of goblet cells, widespread superficial ulcerations, and diffuse continuous colorectal inflammation produce bloody diarrhea and tenesmus.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001206_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001206_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Polygenic susceptibility and environmental triggers initiate loss of self-tolerance against nuclear and ribonucleoprotein autoantigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001206_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001206_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Plasmablasts synthesize low-to-moderate titers of non-specific antinuclear antibodies (ANA) or isolated anti-Ro/SSA or anti-RNP.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001206_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001206_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Mild, non-destructive immune complex deposition and perivascular lymphocytic infiltration in superficial microvascular and joint tissues.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001206_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001206_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Release of low concentrations of pro-inflammatory cytokines without satisfying full classification criteria for defined systemic rheumatic diseases.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001206_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001206_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Chronic mild symptoms (Raynaud&apos;s phenomenon, non-erosive arthralgias, mild leukopenia, cutaneous rash) remaining stable or progressing to a differentiated connective tissue disease.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001207_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001207_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Exposure to medications, infections, or underlying autoimmune disease (SLE, Sjögren&apos;s) stimulates autoantibody production against C1q.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001207_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001207_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Formation of circulating antigen-antibody or anti-C1q immune complexes that deposit within postcapillary venules of the dermis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001207_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001207_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Classical complement cascade activation (profound hypocomplementemia with low C1q, C3, and C4) generates anaphylatoxins C3a and C5a.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001207_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001207_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Degranulation of perivascular mast cells and marked recruitment of polymorphonuclear neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001207_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001207_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Neutrophil leukocytoclasia, endothelial necrosis, and fibrinoid vessel wall destruction produce persistent (&gt;24 h), tender, burning urticarial wheals with purpura and hyperpigmentation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001208_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001208_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of blood-ocular barrier immune privilege triggered by systemic autoimmune diseases (spondyloarthritis, sarcoidosis, Behcet&apos;s) or autoantigens (retinal S-Ag).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001208_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001208_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal expansion and intraocular trafficking of autoreactive CD4+ Th1 (producing IFN-γ) and Th17 (producing IL-17A) lymphocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001208_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001208_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the iris, ciliary body, and/or choroid by lymphocytes, macrophages, and neutrophils.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001208_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001208_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inflammatory cytokine secretion increases microvascular permeability, allowing protein leakage and inflammatory cells into the anterior chamber or vitreous.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001208_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001208_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Ciliary spasm, iris adhesions (synechiae), corneal endothelial keratic precipitates, macular edema, and secondary glaucoma cause painful visual impairment.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001209_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001209_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic risk (HLA-A*02, NLRP1, TYR) combined with oxidative stress in epidermal melanocytes generates reactive oxygen species (ROS).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001209_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001209_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Stressed melanocytes release heat shock protein 70 (HSP70) and damage-associated molecular patterns, activating dermal dendritic cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001209_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001209_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Dendritic cells prime and polarize autoreactive CD8+ cytotoxic T cells specific for melanocyte differentiation antigens (tyrosinase, MART-1).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001209_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001209_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>CD8+ T cells home to the basal epidermis via CXCR3-CXCL10 chemokine signaling and secrete IFN-γ and TNF-α.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001209_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001209_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Perforin/granzyme-mediated targeted apoptosis of epidermal and follicular melanocytes results in total loss of melanin pigment and depigmented cutaneous macules.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001210_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001210_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Strong genetic association with HLA-DRB1*04:05 and HLA-DR4 alleles primes an immune response against melanocyte-specific antigens.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001210_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001210_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Viral trigger or molecular mimicry breaks tolerance to melanocyte proteins (tyrosinase family, MART-1/Melan-A).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001210_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001210_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of melanocyte-bearing tissues (uvea, meninges, inner ear, hair follicles) by autoreactive CD4+ Th1/Th17 and CD8+ cytotoxic T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001210_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001210_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cytotoxic T-cell- and cytokine-mediated destruction of stromal melanocytes throughout the eye, inner ear, skin, and central nervous system.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001210_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001210_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Bilateral diffuse granulomatous panuveitis with exudative retinal detachments, aseptic meningitis, sensorineural dysacusis, poliosis, and vitiligo.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001211_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001211_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of B-cell tolerance in idiopathic settings or secondary to lymphoproliferative disorders or SLE produces warm-reacting autoantibodies.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001211_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001211_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B cells synthesize polyclonal IgG autoantibodies (predominantly IgG1 and IgG3) directed against the Rh polypeptide complex on erythrocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001211_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001211_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>IgG autoantibodies bind red blood cell surface antigens with high affinity at core body temperature (37°C).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001211_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001211_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Fc regions of erythrocyte-bound IgG are recognized by Fcγ receptors (FcγRI, FcγRIIa) on splenic red pulp macrophages, with or without C3b deposition.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001211_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001211_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Splenic macrophages partially phagocytose erythrocyte membranes, creating rigid, non-deformable spherocytes that undergo premature extravascular splenic destruction.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001217_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001217_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Paraneoplastic expression by underlying tumors (small cell lung cancer, thymoma, breast) or unknown trigger initiates an autoimmune response.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001217_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001217_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive B cells generate IgG autoantibodies targeting the extracellular domains of GluA1 or GluA2 subunits of synaptic AMPA receptors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001217_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001217_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies cross into the CNS parenchyma or are produced intrathecally, binding synaptic AMPA receptors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001217_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001217_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Antibody binding induces cross-linking, rapid internalization, and degradation of surface AMPA receptors without complement-mediated lysis.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001217_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001217_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe reduction in synaptic AMPA receptor density disrupts glutamatergic neurotransmission in limbic circuits, causing confusion, memory deficits, psychosis, and seizures.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001218_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001218_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Underlying malignancy (frequently small cell lung carcinoma expressing neuroendocrine antigens) or idiopathic trigger activates GABA_B receptor-specific T and B cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001218_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001218_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Generation of pathogenic autoantibodies targeting the extracellular domain of the GABA_B1 subunit of metabotropic GABA_B receptors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001218_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001218_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies bind GABA_B receptors on limbic, hippocampal, and thalamocortical inhibitory synapses.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001218_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001218_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Receptor binding antagonizes slow inhibitory postsynaptic potentials and interferes with presynaptic neurotransmitter release modulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001218_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001218_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unchecked excitatory glutamatergic signaling in limbic structures causes early and intractable temporal lobe seizures, memory loss, and behavioral abnormalities.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001219_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001219_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Idiopathic or post-infectious presentation of aortic medial and adventitial self-antigens to CD4+ and CD8+ T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001219_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001219_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the thoracic or abdominal aortic wall by autoreactive T lymphocytes and macrophages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001219_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001219_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Cytokine secretion (IFN-γ, IL-6) stimulates local fibroblasts, induces adventitial neoangiogenesis, and recruits matrix metalloproteinase-secreting macrophages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001219_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001219_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Proteolytic degradation of elastic lamellae and medial smooth muscle cell apoptosis destroy aortic mural architecture.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001219_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001219_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Progressive transmural structural remodeling produces fibrous aortic thickening, vessel ectasia, aneurysm formation, or spontaneous aortic dissection.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001220_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001220_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breakdown of intestinal immune homeostasis or genetic mutation (e.g., FOXP3 in IPEX) results in failure of mucosal regulatory T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001220_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001220_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unchecked activation of autoreactive CD4+ Th1/Th17 cells and intraepithelial cytotoxic CD8+ T lymphocytes in the gut lamina propria.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001220_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001220_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Generation of autoantibodies against gut microvilli proteins (harmonin/AE75, villin) and goblet cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001220_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001220_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Massive infiltration of effector lymphocytes induces Fas/FasL- and perforin-dependent apoptosis of small intestinal enterocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001220_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001220_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Total villous atrophy, crypt hyperplasia, and loss of mucosal absorptive surface result in intractable secretory diarrhea, malabsorption, and wasting.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001221_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001221_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Paraneoplastic or primary autoimmunity triggers immune responses against autonomic enteric neuronal antigens or ganglionic acetylcholine receptors (gAChR).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001221_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001221_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Production of circulating antineuronal antibodies (anti-Hu, anti-CRMP5, anti-gAChR) and autoreactive T-cell expansion.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001221_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001221_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Infiltration of the myenteric (Auerbach&apos;s) and submucosal (Meissner&apos;s) plexuses by CD8+ cytotoxic T cells and macrophages.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001221_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001221_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Selective destruction of inhibitory nitrergic (NO-producing) neurons and interstitial cells of Cajal throughout the gastrointestinal tract.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001221_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001221_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of enteric inhibitory coordination results in aperistalsis, defective lower esophageal/pyloric sphincter relaxation, and severe gastrointestinal dysmotility (achalasia, pseudo-obstruction).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001222_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001222_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Post-infectious or paraneoplastic event stimulates cellular immunity against glial fibrillary acidic protein (GFAP).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001222_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001222_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoreactive cytotoxic CD8+ T cells infiltrate the central nervous system perivascular spaces and white matter, accompanied by anti-GFAP IgG.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001222_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001222_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>While anti-GFAP IgG serves as an immunological biomarker, CD8+ cytotoxic T cells directly target GFAP-expressing radial and protoplasmic astrocytes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001222_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001222_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Astroglial end-feet disruption and microglial activation compromise the blood-brain barrier and cause meningeal and perivascular inflammation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001222_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001222_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Transmural perivascular radial inflammation across the brainstem, spine, and optic nerves produces meningoencephalomyelitis, visual deficits, and ataxia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001223_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001223_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic predisposition and immune dysregulation stimulate CD4+ T helper cells against exogenous or endogenous clotting Factor IX.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001223_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001223_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B-cell differentiation generates polyclonal IgG neutralizing autoantibodies directed against Factor IX functional domains.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001223_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001223_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Anti-FIX autoantibodies bind circulating Factor IX, sterically inhibiting its activation by Factor XIa or preventing its catalytic activity in the intrinsic tenase complex.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001223_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001223_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies also facilitate rapid immune-complex clearance of Factor IX from the circulation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001223_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001223_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Severe failure of the intrinsic coagulation cascade prevents secondary hemostasis, causing spontaneous soft tissue hematomas and life-threatening bleeding.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001224_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001224_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoimmune response produces IgG4 class antibodies against cell adhesion molecules at the node of Ranvier and paranode (NF155, CNTN1, Caspr1, NF186).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001224_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001224_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>IgG4 autoantibodies, acting without complement activation, penetrate the blood-nerve barrier and bind paranodal septate-like junctions.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001224_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001224_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoantibodies sterically disrupt the delicate attachment between the Schwann cell terminal loops and the axolemma.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001224_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001224_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Detachment of paranodal loops allows lateral dispersion of voltage-gated sodium channels away from the node of Ranvier.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001224_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001224_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Failure of saltatory nerve conduction produces severe, rapidly progressive, distal sensorimotor ataxia and weakness refractory to conventional IVIg.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001225_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001225_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Emergence of non-complement-fixing IgG4 (or IgG3) autoantibodies directed against contactin-1, contactin-associated protein 1, or neurofascin.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001225_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001225_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>High-affinity autoantibodies bind paranodal junctional complexes connecting myelinating Schwann cells to axonal membranes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001225_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001225_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Disassembly of axoglial junctions causes detachment of terminal myelin loops without overt macrophage-mediated demyelination.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001225_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001225_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Disruption of the paranodal diffusion barrier induces redistribution of nodal Nav channels and Kv channels.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001225_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001225_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Inability to maintain action potential propagation halts saltatory conduction, producing sensory ataxia, tremor, and motor weakness.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001226_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001226_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Genetic susceptibility (HLA-DRB1*11) and environmental triggers provoke loss of tolerance to the metalloprotease ADAMTS13.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001226_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001226_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Clonal B cells synthesize neutralizing IgG autoantibodies (mainly IgG4) directed against the spacer domain of ADAMTS13.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001226_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001226_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Circulating autoantibodies bind and severely deplete ADAMTS13 activity to &lt;10% of normal.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001226_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001226_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Loss of ADAMTS13-mediated cleavage allows ultra-large von Willebrand factor (ULVWF) multimers to accumulate on endothelial surfaces.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001226_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001226_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>High-shear microvascular platelet aggregation forms systemic microthrombi, causing microangiopathic hemolytic anemia, severe thrombocytopenia, and organ ischemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001227_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001227_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Breaching of the blood-testis barrier (in males via trauma, infection, or vasectomy) or altered female genital tract immune tolerance.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001227_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001227_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Antigen-presenting cells process sperm membrane proteins (SP-10, FA-1, Izumo1) and stimulate autoreactive B and T cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001227_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001227_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Synthesis of sperm-immobilizing and agglutinating antibodies (ASAs) of IgG, IgA, and IgM isotypes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001227_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001227_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>ASAs bind motile spermatozoa in seminal plasma, cervical mucus, or oviduct fluid.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001227_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001227_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Agglutination, reduced progressive sperm motility, blocked acrosome reaction, and inhibition of zona pellucida penetration prevent conception.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001228_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001228_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Preceding systemic viral or bacterial infection triggers neuroimmune dysregulation in genetically vulnerable adolescents.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001228_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001228_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Autoimmune or inflammatory infiltration localized to the hypothalamic-pituitary axis and thalamocortical relay circuits.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001228_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001228_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Aberrant cytokine signaling and transient neurotransmitter dysregulation (dopaminergic, serotonergic, and hypocretinergic).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001228_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001228_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Reversible functional impairment of hypothalamic sleep-wake, satiety, and behavioral control centers.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001228_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001228_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Periodic episodic hypersomnia (sleeping 18-20 hours/day) accompanied by cognitive fog, derealization, megaphagia, and hypersexuality.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001229_1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001229_1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Germline de novo or inherited heterozygous gain-of-function mutations in the STAT3 gene.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Step 1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001229_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001229_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Constitutive baseline phosphorylation and hyperactivation of the transcription factor STAT3 downstream of multiple cytokine receptors.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Step 2</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001229_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001229_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Excessive polarization and hyperactivation of CD4+ Th17 effector cells with concomitant impairment of regulatory T-cell (Treg) differentiation.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Step 3</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001229_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001229_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Unrestrained multi-organ inflammatory signaling and loss of peripheral immune tolerance.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Step 4</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_0001229_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_0001229_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <stepDescription>Early-onset multi-organ autoimmunity (type 1 diabetes, autoimmune enteropathy, thyroiditis, cytopenias) accompanied by lymphoproliferation and short stature.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Step 5</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_1_Genetic -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_1_Genetic">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25471517/</sourcePMID>
        <stepCategory>Genetic</stepCategory>
        <stepDescription>HLA-DR3/DR4-DQ, INS VNTR, PTPN22, CTLA4 establish a permissive genetic background.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</stepOrder>
        <rdfs:label>Genetic susceptibility</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_2_Trigger -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_2_Trigger">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/28958587/</sourcePMID>
        <stepCategory>Trigger</stepCategory>
        <stepDescription>Enteroviral infection or dietary antigens precipitate islet autoimmunity in genetically susceptible hosts.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</stepOrder>
        <rdfs:label>Environmental trigger</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_3_Tolerance -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_3_Tolerance">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <stepCategory>Immune</stepCategory>
        <stepDescription>Impaired central/peripheral tolerance and defective Treg function permit autoreactive clones.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</stepOrder>
        <rdfs:label>Loss of immune tolerance</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_4_Presentation -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_4_Presentation">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <stepCategory>Immune</stepCategory>
        <stepDescription>Dendritic cells and macrophages present beta-cell antigens in pancreatic lymph nodes.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</stepOrder>
        <rdfs:label>Antigen presentation</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_5_Autoantibodies -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_5_Autoantibodies">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <stepCategory>Antibody</stepCategory>
        <stepDescription>B-cells produce GADA, IA-2A, IAA and ZnT8A, the serological hallmark of islet autoimmunity.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</stepOrder>
        <rdfs:label>Autoantibody production</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_6_Insulitis -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_6_Insulitis">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
        <stepCategory>Immune</stepCategory>
        <stepDescription>CD8+ cytotoxic and CD4+ Th1 cells infiltrate the islets (insulitis).</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</stepOrder>
        <rdfs:label>T-cell insulitis</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_7_BetaDeath -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_7_BetaDeath">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/30269450/</sourcePMID>
        <stepCategory>TissueDamage</stepCategory>
        <stepDescription>Perforin/granzyme, Fas-FasL and cytokine (IL-1B, IFN-g, TNF) toxicity destroy beta cells.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7</stepOrder>
        <rdfs:label>Beta-cell destruction</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Path_8_Insulin -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Path_8_Insulin">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#PathwayStep"/>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/30609683/</sourcePMID>
        <stepCategory>Outcome</stepCategory>
        <stepDescription>Loss of &gt;80-90% beta-cell mass yields absolute insulin deficiency and clinical hyperglycemia.</stepDescription>
        <stepOrder rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</stepOrder>
        <rdfs:label>Insulin deficiency &amp; hyperglycemia</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Rec_CTLA4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Rec_CTLA4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Receptor"/>
        <componentRelevance>Checkpoint</componentRelevance>
        <mediatorDescription>Checkpoint; reduced in T1D</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25471517/</sourcePMID>
        <rdfs:label>CTLA-4 (CD152)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Rec_Fas -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Rec_Fas">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Receptor"/>
        <componentRelevance>Apoptosis</componentRelevance>
        <mediatorDescription>Death receptor on beta-cells</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25471517/</sourcePMID>
        <rdfs:label>Fas (CD95)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Rec_IL2R -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Rec_IL2R">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Receptor"/>
        <componentRelevance>Treg</componentRelevance>
        <mediatorDescription>Treg maintenance; GWAS locus</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25471517/</sourcePMID>
        <rdfs:label>IL-2R (CD25)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Rec_PD1 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Rec_PD1">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Receptor"/>
        <componentRelevance>Exhaustion</componentRelevance>
        <mediatorDescription>Inhibitory; T1D polymorphisms</mediatorDescription>
        <sourcePMID>https://pubmed.ncbi.nlm.nih.gov/25471517/</sourcePMID>
        <rdfs:label>PD-1 (CD279)</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_11 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_11">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000047"/>
        <rdfs:label>Blisters on various mucous membranes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_12 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_12">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000449"/>
        <rdfs:label>Scarring</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_14 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_14">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>true</ARI_Obsolete>
        <rdfs:label>Arises in younger individuals, usually under the age of 70 years</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_15 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_15">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>true</ARI_Obsolete>
        <rdfs:label>Has prominent involvement of the head and neck</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_16 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_16">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>true</ARI_Obsolete>
        <rdfs:label>Involves mucous membranes</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_2 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_2">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000532"/>
        <rdfs:label>Tense, blood- or pus-filled blisters, mostly on the hands, knees, knuckles, elbows and ankles</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_3 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_3">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000042"/>
        <rdfs:label>Blisters</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_4 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_4">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000320"/>
        <rdfs:label>Mucous-membrane blisters that rupture easily</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_5 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_5">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000584"/>
        <rdfs:label>When blisters heal they form scars and sometimes tiny white bumps</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_7 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_7">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000589"/>
        <rdfs:label>Widespread blisters that are not localized to trauma-prone sites</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_8 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_8">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000590"/>
        <rdfs:label>Widespread redness and itching</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001001_9 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001001_9">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>true</ARI_Obsolete>
        <rdfs:label>Healing with minimal scarring</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001002_18 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001002_18">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000505"/>
        <rdfs:label>Swelling</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001002_20 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001002_20">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000051"/>
        <rdfs:label>Blood in stool</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Sym_0001002_21 -->

    <owl:NamedIndividual rdf:about="http://www.aurint.org/ontologies/ari-disease#Sym_0001002_21">
        <rdf:type rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <ARI_Obsolete>false</ARI_Obsolete>
        <symptomConcept rdf:resource="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000052"/>
        <rdfs:label>Blood in urine</rdfs:label>
    </owl:NamedIndividual>
    


