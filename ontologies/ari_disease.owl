        <ARI_ClinicalSubtype>Cutaneous Mastocytosis, Diffuse - Generalized thickening of the skin.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Cutaneous Mastocytosis, Urticaria Pigmentosa - Brown patches that itch when rubbed.</ARI_ClinicalSubtype>
        <ARI_DOID>3663</ARI_DOID>
