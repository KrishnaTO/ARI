        <ARI_ClinicalSubtype>ANCA-Positive Vasculitis, Eosinophilic Granulomatosis with Polyangiitis (EGPA) - Associated with asthma and eosinophilia.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>ANCA-Positive Vasculitis, Granulomatosis with Polyangiitis (GPA) - Involves respiratory tract and kidneys.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>ANCA-Positive Vasculitis, Microscopic Polyangiitis (MPA) - Primarily affects small blood vessels in kidneys and lungs.</ARI_ClinicalSubtype>
        <ARI_DXCODE>722191003</ARI_DXCODE>
        <ARI_DefSource>Berti 2017; https://pubmed.ncbi.nlm.nih.gov/28881446/; Mohammad 2007; https://pubmed.ncbi.nlm.nih.gov/17553910/</ARI_DefSource>
        <ARI_ICD10>I77.82</ARI_ICD10>
        <ARI_ID>ARI:0001017</ARI_ID>
