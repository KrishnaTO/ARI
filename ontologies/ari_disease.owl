        <ARI_ClinicalSubtype>Alopecia Areata, Ophiasis - Hair loss in a band-like pattern around the scalp.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Alopecia Areata, Patchy - Localized hair loss in small patches.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Alopecia Areata, Totalis - Complete loss of scalp hair.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Alopecia Areata, Universalis - Loss of all body hair.</ARI_ClinicalSubtype>
        <ARI_DOID>986</ARI_DOID>
