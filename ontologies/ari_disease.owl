        <ARI_Synonym>Anti-N-methyl-D-aspartate receptor encephalitis</ARI_Synonym>
        <ARI_Synonym>Anti-NMDA Encephalitis</ARI_Synonym>
        <ARI_Synonym>Anti-NMDA receptor encephalitis</ARI_Synonym>
        <ARI_Synonym>Limbic encephalitis with N-methyl-D-aspartate receptor antibodies</ARI_Synonym>
