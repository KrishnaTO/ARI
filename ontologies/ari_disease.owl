        <ARI_Synonym>CID due to LRBA deficiency</ARI_Synonym>
        <ARI_Synonym>CVID8</ARI_Synonym>
        <ARI_Synonym>Immunodeficiency, Common Variable, 8, with Autoimmunity</ARI_Synonym>
        <ARI_Synonym>LRBA deficiency</ARI_Synonym>
        <ARI_Synonym>Syndromic autoimmune enteropathy due to LPS responsive beige-like anchor protein</ARI_Synonym>
        <ARI_Synonym>Syndromic autoimmune enteropathy due to LRBA deficiency</ARI_Synonym>
        <ARI_Synonym>common variable immunodeficiency 8</ARI_Synonym>
