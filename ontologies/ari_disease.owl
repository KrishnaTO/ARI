        <ARI_ClinicalSubtype>Ulcerative Colitis, Left-Sided - Affects the rectum and descending colon.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Ulcerative Colitis, Pancolitis - Involves the entire colon.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Ulcerative Colitis, Proctitis - Limited to the rectum.</ARI_ClinicalSubtype>
        <ARI_DOID>8577</ARI_DOID>
        <ARI_DXCODE>64766004</ARI_DXCODE>
        <ARI_DefSource>Dahlhamer 2016; https://pubmed.ncbi.nlm.nih.gov/27787492/</ARI_DefSource>
        <ARI_ICD10>K51</ARI_ICD10>
