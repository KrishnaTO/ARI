        <ARI_ClinicalSubtype>Eosinophilic Esophagitis, Adult - Presents with dysphagia and food impaction.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Eosinophilic Esophagitis, Pediatric - Manifests as feeding difficulties.</ARI_ClinicalSubtype>
        <ARI_DOID>13922</ARI_DOID>
        <ARI_DXCODE>235599003</ARI_DXCODE>
        <ARI_DefSource>Moawad 2017; https://pubmed.ncbi.nlm.nih.gov/29129296/</ARI_DefSource>
        <ARI_ICD10>K20.0</ARI_ICD10>
        <ARI_ID>ARI:0001086</ARI_ID>
        <ARI_MESH>D057765</ARI_MESH>
        <ARI_MONDO>0005361</ARI_MONDO>
        <ARI_NCI>C27105</ARI_NCI>
