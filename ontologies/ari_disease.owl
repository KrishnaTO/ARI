        <ARI_ClinicalSubtype>Urticarial Vasculitis, Hypocomplementemic - More severe, with low complement levels.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Urticarial Vasculitis, Normocomplementemic - Mild, normal complement levels.</ARI_ClinicalSubtype>
        <ARI_DXCODE>402656007</ARI_DXCODE>
        <ARI_DefSource>Kolkhir 2020; https://www.ncbi.nlm.nih.gov/pmc/articles/PMC7063238/</ARI_DefSource>
