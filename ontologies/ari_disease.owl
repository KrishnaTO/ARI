        <ARI_ClinicalSubtype>Hemifacial Atrophy, Unilateral - Affects one side of the face.</ARI_ClinicalSubtype>
        <ARI_DOID>1757</ARI_DOID>
        <ARI_DXCODE>718224004</ARI_DXCODE>
        <ARI_DefSource>Gupta 2016; https://www.ncbi.nlm.nih.gov/pmc/articles/PMC4991159/</ARI_DefSource>
