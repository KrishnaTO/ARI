        <ARI_ClinicalSubtype>Autoimmune Angioedema, C1-Inhibitor Deficiency - Caused by autoantibodies affecting complement regulation.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Autoimmune Angioedema, Idiopathic - No clear cause but linked to immune dysfunction.</ARI_ClinicalSubtype>
        <ARI_DXCODE>402401003</ARI_DXCODE>
