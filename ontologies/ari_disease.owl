        <ARI_ClinicalSubtype>Autoimmune Hepatitis, Type 1 - Most common form, can occur at any age.</ARI_ClinicalSubtype>
        <ARI_ClinicalSubtype>Autoimmune Hepatitis, Type 2 - More aggressive, usually affects children.</ARI_ClinicalSubtype>
        <ARI_DOID>2048</ARI_DOID>
        <ARI_DXCODE>408335007</ARI_DXCODE>
        <ARI_DefSource>Boberg 1998; https://pubmed.ncbi.nlm.nih.gov/9489916/</ARI_DefSource>
        <ARI_ICD10>K75.4</ARI_ICD10>
