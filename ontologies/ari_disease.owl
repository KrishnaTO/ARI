        <ARI_MONDO>0007710</ARI_MONDO>
        <ARI_NCI>C116916</ARI_NCI>
        <ARI_OMOP>37397558</ARI_OMOP>
        <ARI_ORPHANET>1214</ARI_ORPHANET>
