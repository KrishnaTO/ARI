        <ari-disease:ARI_ID>UBERON:0002048</ari-disease:ARI_ID>
        <rdfs:comment>The single-lung term, as in category-uberon.csv. pair of lungs is UBERON:0000170.</rdfs:comment>
        <rdfs:label>Lungs</rdfs:label>
    </owl:Class>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#MetabolicSystem -->

    <owl:Class rdf:about="http://www.aurint.org/ontologies/ari-disease#MetabolicSystem">
        <rdfs:subClassOf rdf:resource="http://www.aurint.org/ontologies/ari-disease#MulticellularAnatomicalStructure"/>
        <ari-disease:ARI_NoConcept>no term</ari-disease:ARI_NoConcept>
        <rdfs:comment>UBERON has no metabolic system: metabolism is a process, not an anatomical structure. Kept as an ARI class.</rdfs:comment>
        <rdfs:label>Metabolic System</rdfs:label>
    </owl:Class>
    


