<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.aurint.org/ontologies/ari_anatomy#"
     xml:base="http://www.aurint.org/ontologies/ari_anatomy"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ari-disease="http://www.aurint.org/ontologies/ari-disease#">
    <owl:Ontology rdf:about="http://www.aurint.org/ontologies/ari_anatomy">
        <owl:imports rdf:resource="http://www.aurint.org/ontologies/ari_core"/>
        <owl:imports rdf:resource="http://www.aurint.org/ontologies/ari_uberon"/>
        <rdfs:comment>ARI tissue and system classes (under MulticellularAnatomicalStructure) and the Tissue_* individuals that diseases target. Classes link to UBERON through the ari_uberon import; ARI_NoConcept records a class deliberately left without a term.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.aurint.org/ontologies/ari-disease#AllTissues -->

    <owl:Class rdf:about="http://www.aurint.org/ontologies/ari-disease#AllTissues">
        <rdfs:subClassOf rdf:resource="http://www.aurint.org/ontologies/ari-disease#MulticellularAnatomicalStructure"/>
        <ari-disease:ARI_NoConcept>no term</ari-disease:ARI_NoConcept>
        <rdfs:comment>A catch-all with no UBERON term. Kept as an ARI class. No disease targets it.</rdfs:comment>
        <rdfs:label>All</rdfs:label>
    </owl:Class>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#AnatomicalSystem -->

    <owl:Class rdf:about="http://www.aurint.org/ontologies/ari-disease#AnatomicalSystem">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000467"/>
        <rdfs:subClassOf rdf:resource="http://www.aurint.org/ontologies/ari-disease#MulticellularAnatomicalStructure"/>
        <ari-disease:ARI_ID>UBERON:0000467</ari-disease:ARI_ID>
        <rdfs:label>Anatomical system</rdfs:label>
    </owl:Class>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#BetaCell -->

    <owl:Class rdf:about="http://www.aurint.org/ontologies/ari-disease#BetaCell">
        <rdfs:subClassOf rdf:resource="http://www.aurint.org/ontologies/ari-disease#IsletOfLangerhans"/>
        <ari-disease:ARI_NoConcept>not linked</ari-disease:ARI_NoConcept>
        <rdfs:comment>A cell type, so it belongs to the Cell Ontology, not UBERON. Its individual carries CL:0000169.</rdfs:comment>
        <rdfs:label>Pancreatic beta cell</rdfs:label>
    </owl:Class>
    


    <!-- http://www.aurint.org/ontologies/ari-disease#Bladder -->

    <owl:Class rdf:about="http://www.aurint.org/ontologies/ari-disease#Bladder">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001255"/>
        <rdfs:subClassOf rdf:resource="http://www.aurint.org/ontologies/ari-disease#MulticellularAnatomicalStructure"/>
        <ari-disease:ARI_ID>UBERON:0001255</ari-disease:ARI_ID>
        <rdfs:label>Bladder</rdfs:label>
    </owl:Class>
    


