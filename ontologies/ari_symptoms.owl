<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.aurint.org/ontologies/ari_symptoms#"
     xml:base="http://www.aurint.org/ontologies/ari_symptoms"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#"
     xmlns:ari-disease="http://www.aurint.org/ontologies/ari-disease#">
    <owl:Ontology rdf:about="http://www.aurint.org/ontologies/ari_symptoms">
        <owl:imports rdf:resource="http://www.aurint.org/ontologies/ari_core"/>
        <owl:imports rdf:resource="http://www.aurint.org/ontologies/ari_symp"/>
        <dc:source rdf:resource="http://purl.obolibrary.org/obo/hp/releases/2026-02-16/hp.owl"/>
        <dc:source rdf:resource="http://purl.obolibrary.org/obo/symp/releases/2026-07-30/symp.owl"/>
        <rdfs:comment>ARI symptom classes (ARIS), grouped into a hierarchy under Symptom and mapped to the Symptom Ontology (SYMP) and the Human Phenotype Ontology (HPO). skos:exactMatch names a SYMP or HPO term with the same meaning, skos:broadMatch the nearest broader one. Strings merged into a symptom are skos:altLabel. The per-disease Symptom individuals in ari_disease.owl point at their class with sharedConcept. SYMP terms come from the ari_symp import; HPO terms are referenced by IRI.</rdfs:comment>
    </owl:Ontology>
    


