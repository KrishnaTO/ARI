    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000001 -->

    <owl:Class rdf:about="http://www.aurint.org/ontologies/ari-symptoms#ARIS_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000188"/>
        <rdfs:subClassOf rdf:resource="http://www.aurint.org/ontologies/ari-disease#Symptom"/>
        <oboInOwl:id>ARIS:0000001</oboInOwl:id>
        <rdfs:label>A feeling of fullness or pressure in the chest or abdomen that can cause difficulty breathing or eating</rdfs:label>
        <skos:broadMatch rdf:resource="http://purl.obolibrary.org/obo/HP_0011458"/>
        <skos:broadMatch rdf:resource="http://purl.obolibrary.org/obo/SYMP_0000188"/>
    </owl:Class>
    


