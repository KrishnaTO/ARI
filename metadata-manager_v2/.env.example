# ===== Server-side only. Never commit a real .env. =====
# Leave GitHub vars blank to run the manager locally without the publish feature.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OWNER=KrishnaTO
GITHUB_REPO=ARI

# Branch the app populates from AND opens edit PRs against. This is the "setting"
# that decides which version shows in the app. Defaults to the working branch;
# change it to track a different branch.
GITHUB_BASE_BRANCH=feature/metadata-manager_v2/ARI

# Repo-relative path of the ontology file edits are committed to:
GITHUB_ONTOLOGY_PATH=metadata-manager_v2/ontologies/ari_t1d.owl

APP_BASE_URL=http://localhost:8001
OAUTH_CALLBACK_PATH=/auth/github/callback
SESSION_SECRET=replace_with_64_hex_chars
# Optional comma-separated GitHub logins allowed to publish (empty = any repo user)
ALLOWED_LOGINS=
