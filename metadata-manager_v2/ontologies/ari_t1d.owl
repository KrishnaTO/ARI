<owl:NamedIndividual rdf:about="#T1D_0002">
  <rdf:type rdf:resource="#AutoimmuneDisease"/>
  <hasParentDisease rdf:resource="#T1D_0001"/>
  <hasParentCategory rdf:resource="#Category_Endocrine"/>
  <targetsTissue rdf:resource="#Tissue_BetaCell"/>
  <targetsTissue rdf:resource="#Tissue_Islet"/>
  <hasSymptom rdf:resource="#Sym_LADA_Thirst"/>
  <hasSymptom rdf:resource="#Sym_LADA_WeightLoss"/>
  <hasAntibody rdf:resource="#Ab_LADA_GAD65"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Latent autoimmune diabetes in adults (LADA)</rdfs:label>
  <ARI_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARI:0002</ARI_ID>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LADA is a slowly progressive form of autoimmune diabetes presenting in adulthood, characterized by GAD65 autoantibodies and gradual beta-cell failure that initially does not require insulin, bridging type 1 and type 2 diabetes phenotypes.</rdfs:comment>
  <ARI_Obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#string">false</ARI_Obsolete>
  <ARI_Version rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0</ARI_Version>
  <diseaseCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autoimmune</diseaseCategory>
  <evidenceQuality rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moderate</evidenceQuality>
  <ageRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Adult-onset, typically &gt;30 years</ageRange>
  <prevalencePer100k rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.0</prevalencePer100k>
  <ARI_PrevalenceDesc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">~5-10% of adult-onset diabetes; ~8/100k.</ARI_PrevalenceDesc>
  <ARI_DefSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Diabetes Care LADA consensus; PMID: 32086290</ARI_DefSource>
  <ARI_Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">LADA</ARI_Synonym>
  <ARI_Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Type 1.5 diabetes</ARI_Synonym>
  <ARI_Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slowly progressive IDDM</ARI_Synonym>
  <ARI_Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Latent autoimmune diabetes</ARI_Synonym>
  <ARI_DOID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9744</ARI_DOID>
  <ARI_UMLS rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C2987933</ARI_UMLS>
  <ARI_MONDO rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MONDO:0011027</ARI_MONDO>
  <ARI_ICD10 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E10</ARI_ICD10>
  <ARI_ChangeLog rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-06-12 | System | Initial subtype entry</ARI_ChangeLog>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sym_LADA_Thirst">
  <rdf:type rdf:resource="#Symptom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Polydipsia</rdfs:label>
  <likelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Common (50-70%)</likelihood>
  <symptomDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gradual onset thirst as beta-cell function declines</symptomDescription>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0100627</rdfs:seeAlso>
  <sourcePMID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://pubmed.ncbi.nlm.nih.gov/26494507/</sourcePMID>
  <ARI_Obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#string">false</ARI_Obsolete>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sym_LADA_WeightLoss">
  <rdf:type rdf:resource="#Symptom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Gradual weight loss</rdfs:label>
  <likelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moderate</likelihood>
  <symptomDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Slow weight loss over months to years</symptomDescription>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0001824</rdfs:seeAlso>
  <sourcePMID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://pubmed.ncbi.nlm.nih.gov/26494507/</sourcePMID>
  <ARI_Obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#string">false</ARI_Obsolete>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Ab_LADA_GAD65">
  <rdf:type rdf:resource="#Autoantibody"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-GAD65 (GADA)</rdfs:label>
  <antibodyFrequency rdf:datatype="http://www.w3.org/2001/XMLSchema#string">90-100%</antibodyFrequency>
  <antibodyDiagnosticValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Defining serological marker of LADA</antibodyDiagnosticValue>
  <sourcePMID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://pubmed.ncbi.nlm.nih.gov/26494507/</sourcePMID>
  <ARI_Obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#string">false</ARI_Obsolete>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#T1D_0003">
  <rdf:type rdf:resource="#AutoimmuneDisease"/>
  <hasParentDisease rdf:resource="#T1D_0001"/>
  <hasParentCategory rdf:resource="#Category_Endocrine"/>
  <targetsTissue rdf:resource="#Tissue_BetaCell"/>
  <targetsTissue rdf:resource="#Tissue_Islet"/>
  <hasSymptom rdf:resource="#Sym_Ful_DKA"/>
  <hasSymptom rdf:resource="#Sym_Ful_Flu"/>
  <hasAntibody rdf:resource="#Ab_Ful_GAD65"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fulminant type 1 diabetes</rdfs:label>
  <ARI_ID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ARI:0003</ARI_ID>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fulminant T1D is a rare, abrupt-onset subtype characterized by very rapid beta-cell destruction over days, near-normal HbA1c at presentation despite severe hyperglycemia, and frequent absence of islet autoantibodies. Most cases are reported in East Asia.</rdfs:comment>
  <ARI_Obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#string">false</ARI_Obsolete>
  <ARI_Version rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0</ARI_Version>
  <diseaseCategory rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Autoimmune</diseaseCategory>
  <evidenceQuality rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Moderate</evidenceQuality>
  <ageRange rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Any age; often associated with pregnancy</ageRange>
  <prevalencePer100k rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</prevalencePer100k>
  <ARI_PrevalenceDesc rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rare; predominantly East Asian populations. &lt;1/100k.</ARI_PrevalenceDesc>
  <ARI_DefSource rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Japan Diabetes Society criteria; PMID: 22912766</ARI_DefSource>
  <ARI_Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fulminant diabetes</ARI_Synonym>
  <ARI_Synonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acute-onset type 1 diabetes</ARI_Synonym>
  <ARI_UMLS rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C2349037</ARI_UMLS>
  <ARI_MONDO rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MONDO:0014523</ARI_MONDO>
  <ARI_ICD10 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">E10</ARI_ICD10>
  <ARI_ChangeLog rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-06-12 | System | Initial subtype entry</ARI_ChangeLog>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sym_Ful_DKA">
  <rdf:type rdf:resource="#Symptom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fulminant ketoacidosis</rdfs:label>
  <likelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Very common (&gt;=90%)</likelihood>
  <symptomDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Severe DKA within days of symptom onset</symptomDescription>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0001953</rdfs:seeAlso>
  <sourcePMID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://pubmed.ncbi.nlm.nih.gov/17456842/</sourcePMID>
  <ARI_Obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#string">false</ARI_Obsolete>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Sym_Ful_Flu">
  <rdf:type rdf:resource="#Symptom"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Flu-like prodrome</rdfs:label>
  <likelihood rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Common (70%)</likelihood>
  <symptomDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Preceding viral-like illness before abrupt onset</symptomDescription>
  <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HP:0033273</rdfs:seeAlso>
  <sourcePMID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://pubmed.ncbi.nlm.nih.gov/17456842/</sourcePMID>
  <ARI_Obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#string">false</ARI_Obsolete>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Ab_Ful_GAD65">
  <rdf:type rdf:resource="#Autoantibody"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Anti-GAD65 (GADA)</rdfs:label>
  <antibodyFrequency rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;5%</antibodyFrequency>
  <antibodyDiagnosticValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Usually negative, distinguishing it from classic T1D</antibodyDiagnosticValue>
  <sourcePMID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://pubmed.ncbi.nlm.nih.gov/17456842/</sourcePMID>
  <ARI_Obsolete rdf:datatype="http://www.w3.org/2001/XMLSchema#string">false</ARI_Obsolete>
</owl:NamedIndividual>


