  <mediatorDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Elevated in T1D; contributes to vascular complication risk</mediatorDescription>
  <componentRelevance rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vascular risk</componentRelevance>
  <sourcePMID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
