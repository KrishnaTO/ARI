  <mediatorDescription rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Primary autoantigen; B:9-23 epitope central to disease initiation</mediatorDescription>
  <componentRelevance rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Primary autoantigen</componentRelevance>
  <sourcePMID rdf:datatype="http://www.w3.org/2001/XMLSchema#string">https://pubmed.ncbi.nlm.nih.gov/25614315/</sourcePMID>
