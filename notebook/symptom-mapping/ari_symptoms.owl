         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xml:base="http://www.aurint.org/ontologies/ari-symptoms"
         xmlns="http://www.aurint.org/ontologies/ari-symptoms#">

<owl:Ontology rdf:about="http://www.aurint.org/ontologies/ari-symptoms">
    <rdfs:comment>ARI symptoms grouped into a hierarchy and mapped to the Symptom Ontology (SYMP) and the Human Phenotype Ontology (HPO) for ARI#132, generated from notebook/symptom-mapping/symptom_mapping.tsv. skos:exactMatch names a SYMP or HPO term with the same meaning, skos:broadMatch the nearest broader one. Strings merged into a symptom are skos:altLabel. ariSymptomIndividual links the Symptom individuals in ontologies/ari_t1d.owl that carry the symptom. SYMP classes are copied with their labels and is_a parents only; HPO terms are referenced by IRI.</rdfs:comment>
    <dc:source rdf:resource="http://purl.obolibrary.org/obo/symp/releases/2026-07-30/symp.owl"/>
    <dc:source rdf:resource="http://purl.obolibrary.org/obo/hp/releases/2026-02-16/hp.owl"/>
</owl:Ontology>

<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch"/>
<owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
<owl:AnnotationProperty rdf:about="http://www.geneontology.org/formats/oboInOwl#id"/>
<owl:AnnotationProperty rdf:about="#ariSymptomIndividual">
    <rdfs:label>ARI symptom individual</rdfs:label>
</owl:AnnotationProperty>

