    <relation>is_a</relation>
    <confidence>medium</confidence>
    <reason>Rasmussen syndrome presents as drug-resistant focal epilepsy (epilepsia partialis continua).</reason>
</owl:Axiom>

<owl:Axiom>
    <owl:annotatedSource rdf:resource="https://diseases.autoimmuneregistry.org/disease/ARI_0001180"/>
