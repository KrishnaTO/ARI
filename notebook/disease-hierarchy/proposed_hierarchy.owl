    <relation>is_a</relation>
    <confidence>low</confidence>
    <reason>DOID puts pure red cell aplasia under aplastic anemia, but PRCA fails one lineage and aplastic anemia all three. Siblings under bone-marrow failure is more accurate.</reason>
</owl:Axiom>

<owl:Axiom>
    <owl:annotatedSource rdf:resource="https://diseases.autoimmuneregistry.org/disease/ARI_0001175"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
