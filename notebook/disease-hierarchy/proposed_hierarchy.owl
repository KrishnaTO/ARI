    <relation>is_a</relation>
    <confidence>high</confidence>
    <reason>Polymyositis is an idiopathic inflammatory myopathy (0001139's definition names it).</reason>
</owl:Axiom>

<owl:Axiom>
    <owl:annotatedSource rdf:resource="https://diseases.autoimmuneregistry.org/disease/ARI_0001170"/>
    <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
