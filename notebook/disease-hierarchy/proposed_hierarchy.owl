<owl:Ontology rdf:about="http://www.aurint.org/ontologies/ari-disease-proposed-hierarchy">
    <rdfs:comment>Proposed parent links between ARI diseases for ARI#137 and ARI#138, generated from notebook/disease-hierarchy/proposed_parents.tsv for viewing. Not the record: ontologies/ari_t1d.owl is.</rdfs:comment>
</owl:Ontology>

<owl:AnnotationProperty rdf:about="#ariId"/>
<owl:AnnotationProperty rdf:about="#relation"/>
<owl:AnnotationProperty rdf:about="#confidence"/>
<owl:AnnotationProperty rdf:about="#reason"/>
<owl:ObjectProperty rdf:about="#hasComponent">
    <rdfs:label>has component</rdfs:label>
</owl:ObjectProperty>

